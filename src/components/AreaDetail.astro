---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import { areas } from '../data/areas';
interface Props { slug:string }
const area = areas.find(item => item.slug === Astro.props.slug);
if (!area) throw new Error(`Unknown area ${Astro.props.slug}`);
const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const areaUrl = new URL(`/مناطق/${area.slug}/`, siteUrl).href;
const currentIndex = areas.findIndex(item => item.slug === area.slug);
const relatedAreas = [...areas.slice(currentIndex + 1), ...areas.slice(0, currentIndex)].slice(0, 4);
---
<Layout title={`صنايعي كور ${area.name} | تخريم وقص الخرسانة — 01271940742`} description={`اطلب صنايعي كور في ${area.name} لفتحات التكييف والغاز والسباكة وقص الخرسانة. اتصل على 01271940742 وأرسل الصور والمقاسات لتأكيد التغطية وعرض السعر.`}>
<div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><a href="/مناطق/">مناطق الخدمة</a><span>›</span><span>{area.name}</span></nav><h1>صنايعي كور في {area.name} — 01271940742</h1><p>{area.intro}</p><div class="core-actions"><a href="#quote" class="btn btn-primary">اطلب الخدمة في {area.name}</a><a href="tel:+201271940742" class="btn btn-outline"><bdi>01271940742</bdi></a></div></div></div>
<section class="section area-showcase"><div class="container area-showcase-grid"><figure><img src={area.image} alt={area.imageAlt} width="1600" height="1067" loading="lazy" decoding="async" /><figcaption>{area.imageCaption}</figcaption></figure><div><span class="section-label">أعمال الكور والقص</span><h2>طلب منظم لخدمة أدق في {area.name}</h2><p class="spaced-copy">صور الموقع والمقاس ونوع الخدمة والعنوان التقريبي تساعد على مراجعة الطلب قبل ترتيب الزيارة. لا يعني وجود هذه الصفحة وجود فرع ثابت أو موعد مضمون في المنطقة.</p><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تفاصيل تخريم الخرسانة بالكور ←</a></div></div></section>
<section class="section"><div class="container"><div class="section-header"><h2>ما الذي نراجعه قبل زيارة موقعك؟</h2></div><div class="grid-3">{area.notes.map(([name,text]) => <div class="card"><h3>{name}</h3><p class="spaced-copy">{text}</p></div>)}</div></div></section>
<section class="section-alt"><div class="container core-guide-grid"><div><h2>الخدمة المناسبة لموقعك</h2><p class="spaced-copy"><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تخريم الخرسانة بالكور</a> للفتحات الدائرية، أو <a class="text-link" href="/خدماتنا/قص-الخرسانة-بالمنشار/">القص بالمنشار</a> للفتحات المستقيمة والمستطيلة وفق مراجعة متطلبات التنفيذ.</p><div class="check-list"><div><a class="text-link" href="/خدماتنا/فتحات-تكييف/">فتحات التكييف والتهوية ←</a></div><div><a class="text-link" href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز والشفاطات ←</a></div><div><a class="text-link" href="/خدماتنا/فتحات-سباكة/">فتحات السباكة والصرف ←</a></div></div></div><aside class="card"><h2 style="font-size:1.4rem">تحديد المنطقة عند التواصل</h2><ul class="area-places">{area.places.map(place => <li>{place}</li>)}</ul><p class="quote-note">تواصل لتأكيد تغطية عنوانك وترتيبات الزيارة. لا نفترض وجود فرع أو مقر في كل منطقة مذكورة.</p></aside></div></section>
<section class="section"><div class="container" style="max-width:860px"><div class="section-header"><span class="section-label">سؤال شائع</span><h2>{area.faq[0]}</h2><p>{area.faq[1]}</p></div></div></section>
<section class="section-alt"><div class="container"><div class="section-heading-row"><div><span class="section-label">نطاق الخدمة</span><h2>محافظات ومناطق أخرى</h2></div><a class="text-link" href="/مناطق/">كل مناطق الخدمة ←</a></div><div class="grid-4">{relatedAreas.map(related => <a class="core-service" href={`/مناطق/${related.slug}/`}><h3>{related.name}</h3><p>{related.places.slice(0, 2).join('، ')}</p><span class="text-link">تفاصيل الخدمة ←</span></a>)}</div></div></section>
<section class="section" id="quote"><div class="container core-guide-grid"><div><h2>عرض سعر لشغلك في {area.name}</h2><p class="spaced-copy">اكتب المنطقة وعدد الفتحات ومقاساتها وسُمك الخامة إن أمكن. أضف صور الموقع في محادثة واتساب، ثم نراجع التكلفة والموعد والبنود المشمولة.</p><a class="text-link" href="/اسعار-الخدمات/">ما الذي يؤثر على سعر التخريم؟ ←</a><p class="spaced-copy">أي تعديل في عنصر إنشائي يحتاج مراجعة واعتماد مهندس قبل التنفيذ. المقاس الخاص بالتمديد يحدده فني التركيب أو جهة الخدمة.</p></div><QuoteRequest initialArea={area.name} /></div></section>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Service','@id':`${areaUrl}#service`,name:`تخريم وقص الخرسانة في ${area.name}`,serviceType:'تخريم الخرسانة بالكور دريل وقص الخرسانة بالمنشار',description:`خدمة تخريم وقص الخرسانة في ${area.name} بعد مراجعة الموقع وتأكيد التغطية والموعد.`,url:areaUrl,provider:{'@id':`${siteUrl}/#business`},areaServed:{'@type':'AdministrativeArea',name:area.name}})} />
</Layout>
<style>
  .area-places{padding:20px 22px 0;list-style:disc;display:grid;gap:10px}
  .area-showcase-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);align-items:center;gap:clamp(24px,5vw,64px)}
  .area-showcase figure{margin:0;border:1px solid var(--border);border-radius:18px;overflow:hidden;background:var(--surface)}
  .area-showcase img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}
  .area-showcase figcaption{padding:12px 16px;color:var(--text-muted);font-size:.9rem}
  #quote{scroll-margin-top:100px}
  @media(max-width:760px){.area-showcase-grid{grid-template-columns:1fr}}
</style>
