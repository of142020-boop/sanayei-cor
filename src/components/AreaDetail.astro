---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import { areas } from '../data/areas';
interface Props { slug:string }
const area = areas.find(item => item.slug === Astro.props.slug);
if (!area) throw new Error(`Unknown area ${Astro.props.slug}`);
---
<Layout title={`صنايعي كور ${area.name} | تخريم وقص الخرسانة — 01271940742`} description={`اطلب صنايعي كور في ${area.name} لفتحات التكييف والغاز والسباكة وقص الخرسانة. اتصل على 01271940742 وأرسل الصور والمقاسات لتأكيد التغطية وعرض السعر.`}>
<div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><a href="/مناطق/">مناطق الخدمة</a><span>›</span><span>{area.name}</span></nav><h1>صنايعي كور في {area.name} — 01271940742</h1><p>{area.intro}</p><div class="core-actions"><a href="#quote" class="btn btn-primary">اطلب الخدمة في {area.name}</a><a href="tel:+201271940742" class="btn btn-outline"><bdi>01271940742</bdi></a></div></div></div>
<section class="section"><div class="container"><div class="section-header"><h2>ما الذي نراجعه قبل زيارة موقعك؟</h2></div><div class="grid-3">{area.notes.map(([name,text]) => <div class="card"><h3>{name}</h3><p class="spaced-copy">{text}</p></div>)}</div></div></section>
<section class="section-alt"><div class="container core-guide-grid"><div><h2>الخدمة المناسبة لموقعك</h2><p class="spaced-copy"><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تخريم الخرسانة بالكور</a> للفتحات الدائرية، أو <a class="text-link" href="/خدماتنا/قص-الخرسانة-بالمنشار/">القص بالمنشار</a> للفتحات المستقيمة والمستطيلة وفق مراجعة متطلبات التنفيذ.</p><div class="check-list"><div><a class="text-link" href="/خدماتنا/فتحات-تكييف/">فتحات التكييف والتهوية ←</a></div><div><a class="text-link" href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز والشفاطات ←</a></div><div><a class="text-link" href="/خدماتنا/فتحات-سباكة/">فتحات السباكة والصرف ←</a></div></div></div><aside class="card"><h2 style="font-size:1.4rem">تحديد المنطقة عند التواصل</h2><ul class="area-places">{area.places.map(place => <li>{place}</li>)}</ul><p class="quote-note">تواصل لتأكيد تغطية عنوانك وترتيبات الزيارة. لا نفترض وجود فرع أو مقر في كل منطقة مذكورة.</p></aside></div></section>
<section class="section" id="quote"><div class="container core-guide-grid"><div><h2>عرض سعر لشغلك في {area.name}</h2><p class="spaced-copy">اكتب المنطقة وعدد الفتحات ومقاساتها وسُمك الخامة إن أمكن. أضف صور الموقع في محادثة واتساب، ثم نراجع التكلفة والموعد والبنود المشمولة.</p><a class="text-link" href="/اسعار-الخدمات/">ما الذي يؤثر على سعر التخريم؟ ←</a><p class="spaced-copy">أي تعديل في عنصر إنشائي يحتاج مراجعة واعتماد مهندس قبل التنفيذ. المقاس الخاص بالتمديد يحدده فني التركيب أو جهة الخدمة.</p></div><QuoteRequest initialArea={area.name} /></div></section>
</Layout>
<style>.area-places{padding:20px 22px 0;list-style:disc;display:grid;gap:10px}#quote{scroll-margin-top:100px}</style>
