---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import { areas } from '../data/areas';

interface Props {
  slug: string;
}

const area = areas.find(item => item.slug === Astro.props.slug);
if (!area) throw new Error(`Unknown area: ${Astro.props.slug}`);

const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const areaUrl = new URL(`/مناطق/${area.slug}/`, siteUrl).href;
const currentIndex = areas.findIndex(item => item.slug === area.slug);
const relatedAreas = [...areas.slice(currentIndex + 1), ...areas.slice(0, currentIndex)].slice(0, 4);

const faqs: [string, string][] = [
  area.faq,
  [
    `ما خدمات الكور والقص المتوفرة في ${area.name}؟`,
    `ننفذ في ${area.name} فتحات الكور للتكييف والغاز والسباكة والشفاطات بأقطار 1–12 بوصة، وقص الخرسانة بالمنشار الماسي لفتح الأبواب والشبابيك، وتزريع أشاير الحديد بالإيبوكسي.`
  ],
  [
    `كيف يُحدد سعر فتحة الكور أو متر القص في ${area.name}؟`,
    `تُحسب التكلفة حسب القطر وسُمك الخرسانة والعدد أو أمتار القص الطولي وموقع التنفيذ داخل ${area.name}، وتُؤكد كاملة قبل التحرك.`
  ],
];

const areaServiceSchema = {
  '@type': 'Service',
  '@id': `${areaUrl}#service`,
  name: `تخريم وقص الخرسانة بالكور والمنشار في ${area.name}`,
  serviceType: 'تخريم الخرسانة بالكور دريل وقص الخرسانة بالمنشار الماسي',
  description: area.seoDescription,
  url: areaUrl,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: area.name,
  },
};
---

<Layout
  title={area.seoTitle}
  description={area.seoDescription}
  faqs={faqs}
  extraGraph={[areaServiceSchema]}
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <a href="/مناطق/">مناطق الخدمة</a><span>›</span>
        <span>{area.name}</span>
      </nav>
      <h1>صنايعي كور في {area.name} — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">{area.intro}</p>
      <div class="actions-row">
        <a href="tel:+201271940742" class="btn btn-primary">اتصل الآن <bdi dir="ltr">01271940742</bdi></a>
        <a href="#quote" class="btn btn-outline">اطلب تسعيرًا في {area.name}</a>
      </div>
    </div>
  </header>

  <section class="section-surface">
    <div class="container split-wide-first">
      <div class="prose">
        <h2>طبيعة أعمال التخريم والقص الماسي في {area.name}</h2>
        <p>{area.buildingContext}</p>
        <h3>أبرز الأعمال التي ننفذها في {area.name}</h3>
        <ul>
          {area.typicalJobs.map(job => <li>{job}</li>)}
        </ul>
        <div class="actions-row">
          <a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تفاصيل تخريم الخرسانة بالكور ←</a>
          <a class="text-link" href="/خدماتنا/قص-الخرسانة-بالمنشار/">خدمة قص الخرسانة بالمنشار ←</a>
        </div>
      </div>

      <figure class="work-gallery-card">
        <img
          src={area.image}
          alt={area.imageAlt}
          width="1600"
          height="1067"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{area.imageCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">تجهيز وتنفيذ منظم</span>
        <h2>ضوابط التنفيذ في مواقع {area.name}</h2>
        <div class="check-list mt-16">
          {area.notes.map(([heading, body]) => (
            <div>
              <b>{heading}</b>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="card">
        <h3>النطاقات والمناطق المغطاة في {area.name}</h3>
        <ul class="bullet-list">
          {area.places.map(place => <li>{place}</li>)}
        </ul>
        <div class="mt-24">
          <a class="text-link" href="/خدماتنا/فتحات-تكييف/">فتحات التكييف والتهوية ←</a>
        </div>
        <div class="mt-16">
          <a class="text-link" href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز ومداخن السخانات ←</a>
        </div>
        <div class="mt-16">
          <a class="text-link" href="/خدماتنا/تركيب-وتأسيس-شفاطات/">تركيب وتأسيس الشفاطات ←</a>
        </div>
        <div class="mt-16">
          <a class="text-link" href="/خدماتنا/فتحات-سباكة/">فتحات السباكة والصرف ←</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-surface">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">الأسئلة الشائعة</span>
        <h2>أسئلة عن خدمات الكور في {area.name}</h2>
        <p class="spaced-copy">إجابات مباشرة حول التغطية والتسعير ونوع المعدات المستخدمة.</p>
        <a class="text-link" href="/اسعار-الخدمات/">جدول الأسعار الاسترشادية ←</a>
      </div>
      <div class="native-faq">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt" id="quote">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">حجز موعد في {area.name}</span>
        <h2>اطلب تسعير أعمال الكور أو القص في {area.name}</h2>
        <p class="spaced-copy">
          أرسل عدد الفتحات والقطر وسُمك الخرسانة أو أبعاد القص، وسنؤكد لك التكلفة وموعد الزيارة فورًا عبر الهاتف <a class="text-link" href="tel:+201271940742"><bdi dir="ltr">01271940742</bdi></a> أو واتساب.
        </p>
      </div>
      <QuoteRequest initialArea={area.name} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="section-label">مناطق مجاورة</span>
          <h2>محافظات ومناطق خدمة أخرى</h2>
        </div>
        <a class="text-link" href="/مناطق/">جميع المناطق ←</a>
      </div>
      <div class="grid-4">
        {relatedAreas.map(related => (
          <a class="service-card" href={`/مناطق/${related.slug}/`}>
            <h3>{related.name}</h3>
            <p>{related.places.slice(0, 2).join('، ')}</p>
            <span class="text-link">تفاصيل المنطقة ←</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
