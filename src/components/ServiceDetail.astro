---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import WorkGallery from './WorkGallery.astro';
import { services } from '../data/services';
interface Props { slug: string }
const service = services.find(item => item.slug === Astro.props.slug);
if (!service) throw new Error(`Unknown service: ${Astro.props.slug}`);
const related = services.filter(item => item.slug !== service.slug).slice(0,3);
const url = new URL(`/خدماتنا/${service.slug}/`, Astro.site).href;
const sawGallery = service.slug === 'قص-الخرسانة-بالمنشار' ? [
  { src: '/images/work-gallery/work-25-diamond-wall-saw-rail.webp', alt: 'منشار حائط ماسي على سكة لقص الخرسانة' },
  { src: '/images/work-gallery/work-19-wire-saw-industrial.webp', alt: 'منشار سلك ماسي داخل موقع صناعي' },
  { src: '/images/work-gallery/work-20-wire-saw-rail.webp', alt: 'معدات قص خرسانة بالسلك الماسي على مسار' },
  { src: '/images/work-gallery/work-21-wire-saw-cutting.webp', alt: 'تجهيز قص خرساني بالسلك الماسي' },
  { src: '/images/work-gallery/work-23-wire-saw-demolition.webp', alt: 'معدات قص خرسانة في موقع هدم' },
  { src: '/images/work-gallery/work-24-wire-saw-outdoor.webp', alt: 'منشار سلك ماسي في موقع خارجي' },
] : [];
---
<Layout title={`${service.name} | صنايعي كور — اتصل 01271940742`} description={`${service.description} اتصل الآن على 01271940742 لطلب عرض سعر.`} navbarStyle="solid">
  <div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><a href="/خدماتنا/">الخدمات</a><span>›</span><span>{service.short}</span></nav><h1>{service.name} — اتصل 01271940742</h1><p>{service.intro}</p><div class="core-actions"><a href="#quote" class="btn btn-primary">اطلب عرض سعر للخدمة</a><a href="tel:+201271940742" class="btn btn-outline">اتصل <bdi>01271940742</bdi></a></div><nav aria-label="محتوى الخدمة"><a href="#details">تفاصيل الخدمة</a><span>·</span><a href="#prepare">قبل الزيارة</a><span>·</span><a href="#questions">أسئلة شائعة</a></nav></div></div>
  <section class="section" id="details"><div class="container core-guide-grid"><div><h2>{service.heading}</h2>{service.paragraphs.map(text => <p class="spaced-copy">{text}</p>)}<a href={`/مقالات/${service.article}/`} class="text-link">{service.articleLabel} ←</a></div><aside class="card" id="prepare"><h2 style="font-size:1.4rem">ما المطلوب قبل الزيارة؟</h2><ul class="service-checklist">{service.checklist.map(item => <li>{item}</li>)}</ul></aside></div></section>
  {sawGallery.length > 0 && <WorkGallery title="منشار الخرسانة أثناء التنفيذ" description="صور توضيحية لمعدات القص الماسي والمنشار على السكة في أعمال الخرسانة." images={sawGallery} />}
  <section class="section-alt"><div class="container core-guide-grid"><div><span class="section-label">اتفاق واضح</span><h2>ما الذي يشمله طلبك؟</h2><p class="spaced-copy">{service.boundaries}</p></div><div><h2>كيف تتحدد التكلفة؟</h2><p class="spaced-copy">{service.pricing}</p><a href="/اسعار-الخدمات/" class="text-link">عوامل تسعير الخدمات ←</a></div></div></section>
  <section class="section" id="questions"><div class="container core-guide-grid"><div><h2>أسئلة عن {service.short}</h2><p class="spaced-copy">التفاصيل قبل الزيارة تساعدك تختار الخدمة وتتفق على نطاق العمل.</p><a href="/الاسئلة-الشائعة/" class="text-link">المزيد من الأسئلة ←</a></div><div class="native-faq">{service.faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
  <section class="section-alt" id="quote"><div class="container core-guide-grid"><div><span class="section-label">أرسل تفاصيل موقعك</span><h2>اطلب {service.short}</h2><p class="spaced-copy">جهّز المنطقة والمقاسات والصور. سنراجع إمكانية الخدمة ونتفق على التكلفة والموعد بعد الاطلاع على التفاصيل.</p><a href="/مناطق/" class="text-link">راجع مناطق الخدمة ←</a></div><QuoteRequest initialService={service.short} /></div></section>
  <section class="section"><div class="container"><h2>خدمات مرتبطة بشغلك</h2><div class="grid-3 mt-32">{related.map(item => <a class="core-service" href={`/خدماتنا/${item.slug}/`}><h3>{item.short}</h3><p>{item.intro}</p><span class="text-link">تفاصيل الخدمة ←</span></a>)}</div><div class="mt-24"><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">خدمة تخريم الخرسانة بالكور دريل ←</a></div></div></section>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Service','@id':`${url}#service`,name:service.name,description:service.description,url,provider:{'@id':`${Astro.site}#business`}})} />
</Layout>
<style>.service-checklist{list-style:disc;padding-right:22px;margin-top:20px;display:grid;gap:14px}.service-checklist li{font-size:.92rem;color:var(--text-body)}section[id],aside[id]{scroll-margin-top:100px}</style>
