---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import WorkGallery from './WorkGallery.astro';
import { services } from '../data/services';
interface Props { slug: string }
const service = services.find(item => item.slug === Astro.props.slug);
if (!service) throw new Error(`Unknown service: ${Astro.props.slug}`);
const exhaustInstallation = services.find(item => item.slug === 'تركيب-وتأسيس-شفاطات')!;
const related = service.slug === 'فتحات-الغاز-والشفاطات'
  ? [exhaustInstallation, ...services.filter(item => item.slug !== service.slug && item.slug !== exhaustInstallation.slug)].slice(0, 3)
  : services.filter(item => item.slug !== service.slug).slice(0,3);
const url = new URL(`/خدماتنا/${service.slug}/`, Astro.site).href;
const isExhaustInstallation = service.slug === 'تركيب-وتأسيس-شفاطات';
const sawGallery = service.slug === 'قص-الخرسانة-بالمنشار' ? [
  { src: '/images/work-gallery/work-25-diamond-wall-saw-rail.webp', alt: 'منشار حائط ماسي على سكة لقص الخرسانة' },
  { src: '/images/work-gallery/work-19-wire-saw-industrial.webp', alt: 'منشار سلك ماسي داخل موقع صناعي' },
  { src: '/images/work-gallery/work-20-wire-saw-rail.webp', alt: 'معدات قص خرسانة بالسلك الماسي على مسار' },
  { src: '/images/work-gallery/work-21-wire-saw-cutting.webp', alt: 'تجهيز قص خرساني بالسلك الماسي' },
  { src: '/images/work-gallery/work-23-wire-saw-demolition.webp', alt: 'معدات قص خرسانة في موقع هدم' },
  { src: '/images/work-gallery/work-24-wire-saw-outdoor.webp', alt: 'منشار سلك ماسي في موقع خارجي' },
] : [];
const exhaustGallery = isExhaustInstallation ? [
  { src: '/images/work-gallery/work-14-core-drill-vent.webp', alt: 'تجهيز مخرج دكت تهوية في حائط باستخدام الكور دريل' },
  { src: '/images/work-gallery/work-17-core-hole-wall.webp', alt: 'فتحة كور دائرية في حائط لمرور وصلة دكت الشفاط' },
  { src: '/images/work-gallery/work-22-hilti-core-drill-wall.webp', alt: 'معدة كور دريل أثناء تجهيز فتحة حائط لمسار تهوية' },
] : [];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: service.faqs.map(([question, answer]) => ({
    '@type': 'Question', name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<Layout title={`${service.name} | صنايعي كور — اتصل 01271940742`} description={`${service.description} اتصل الآن على 01271940742 لطلب عرض سعر.`} navbarStyle="solid">
  <div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><a href="/خدماتنا/">الخدمات</a><span>›</span><span>{service.short}</span></nav><h1>{service.name} — اتصل 01271940742</h1><p>{service.intro}</p><div class="core-actions"><a href="#quote" class="btn btn-primary">اطلب عرض سعر للخدمة</a><a href="tel:+201271940742" class="btn btn-outline">اتصل <bdi>01271940742</bdi></a></div><nav aria-label="محتوى الخدمة"><a href="#details">تفاصيل الخدمة</a><span>·</span><a href="#prepare">قبل الزيارة</a><span>·</span><a href="#questions">أسئلة شائعة</a></nav></div></div>
  <section class="section" id="details"><div class="container core-guide-grid"><div><h2>{service.heading}</h2>{service.paragraphs.map(text => <p class="spaced-copy">{text}</p>)}<a href={`/مقالات/${service.article}/`} class="text-link">{service.articleLabel} ←</a></div><aside class="card" id="prepare"><h2 style="font-size:1.4rem">ما المطلوب قبل الزيارة؟</h2><ul class="service-checklist">{service.checklist.map(item => <li>{item}</li>)}</ul></aside></div></section>
  {sawGallery.length > 0 && <WorkGallery title="منشار الخرسانة أثناء التنفيذ" description="صور توضيحية لمعدات القص الماسي والمنشار على السكة في أعمال الخرسانة." images={sawGallery} />}
  {isExhaustInstallation && <>
    <section class="section-alt" aria-labelledby="exhaust-steps-h"><div class="container"><div class="section-header section-header-wide"><span class="section-label">من المعاينة إلى اختبار مسار الهواء</span><h2 id="exhaust-steps-h">مراحل تركيب وتأسيس الشفاط</h2><p>لا نعامل تركيب شفاط المطبخ أو الحمام كقطعة تُثبت في الحائط فقط؛ المطلوب أن يكون موضع الجهاز ومسار الدكت ومخرج الهواء مناسبين للموديل والموقع.</p></div><ol class="installation-steps"><li><b>راجع نوع الشفاط والموديل</b><span>شفاط بلت إن، مدخنة، شباك أو حمام: لكل نوع طريقة تثبيت ووصلة دكت ومتطلبات مختلفة. وجود صورة للموديل أو كتيب الجهاز يمنع اختيار فتحة أو مسار غير مناسبين.</span></li><li><b>حدد مكان الجهاز ومخرج الهواء</b><span>نراجع مكان التثبيت والمسافة حتى المخرج وإمكانية المرور في الحائط أو السقف أو المنور. لا يُحدد قطر الفتحة من شكل الجهاز الخارجي، بل من وصلة الدكت والخلوص المطلوب.</span></li><li><b>جهّز الدكت أو فتحة الكور عند الحاجة</b><span>في المخرج الدائري عبر خرسانة أو مباني، تُراجع خدمة <a href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز والشفاطات بالكور</a>. الفتحة المستطيلة أو الزجاج لها تقييم مستقل قبل البدء.</span></li><li><b>ثبّت الجهاز واختبر مسار الهواء</b><span>بعد الاتفاق على نطاق العمل، يُراجع تثبيت الشفاط والدكت والمخرج المتفق عليهما. أعمال الكهرباء أو أي تعديل في الدائرة ليست بديلًا عن كهربائي مختص.</span></li></ol></div></section>
    <section class="section" aria-labelledby="exhaust-types-h"><div class="container"><div class="section-header section-header-wide"><span class="section-label">اختيار صحيح من البداية</span><h2 id="exhaust-types-h">أي تأسيس يناسب شفاطك؟</h2></div><div class="grid-3"><article class="card"><h3>شفاط مطبخ بمدخنة</h3><p class="spaced-copy">يحتاج مسار دكت واضحًا ومخرجًا خارجيًا مناسبًا. قبل التركيب نراجع قطر الوصلة، طول المسار، الانحناءات ومكان خروج الهواء بدل الاعتماد على مقاس شائع.</p></article><article class="card"><h3>شفاط بلت إن</h3><p class="spaced-copy">يتطلب تنسيقًا مع وحدة المطبخ ومكان التثبيت وتعليمات الموديل. لا نفترض أن كل شفاط بلت إن يستخدم نفس المدخنة أو نفس مقاس الدكت.</p></article><article class="card"><h3>شفاط حمام أو تهوية</h3><p class="spaced-copy">نراجع اتجاه الطرد ومسار الدكت وإمكانية المخرج، خصوصًا إذا كان المرور في سقف أو منور أو قرب خدمات قائمة. أي فتحة في عنصر إنشائي تحتاج اعتمادًا مناسبًا.</p></article></div><div class="core-actions"><a href="#quote" class="btn btn-primary">اطلب تركيب أو تأسيس شفاط</a><a href={`/مقالات/${service.article}/`} class="btn btn-outline">اقرأ دليل المدخنة والدكت</a></div></div></section>
    <WorkGallery title="تجهيز مخرج الدكت والتهوية" description="صور توضيحية لأعمال الكور المستخدمة عند الحاجة إلى تجهيز مخرج دائري لدكت الشفاط. يحدد المقاس النهائي من وصلة الجهاز ومسار التركيب." images={exhaustGallery} />
  </>}
  <section class="section-alt"><div class="container core-guide-grid"><div><span class="section-label">اتفاق واضح</span><h2>ما الذي يشمله طلبك؟</h2><p class="spaced-copy">{service.boundaries}</p></div><div><h2>كيف تتحدد التكلفة؟</h2><p class="spaced-copy">{service.pricing}</p><a href="/اسعار-الخدمات/" class="text-link">عوامل تسعير الخدمات ←</a></div></div></section>
  <section class="section" id="questions"><div class="container core-guide-grid"><div><h2>أسئلة عن {service.short}</h2><p class="spaced-copy">التفاصيل قبل الزيارة تساعدك تختار الخدمة وتتفق على نطاق العمل.</p><a href="/الاسئلة-الشائعة/" class="text-link">المزيد من الأسئلة ←</a></div><div class="native-faq">{service.faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
  <section class="section-alt" id="quote"><div class="container core-guide-grid"><div><span class="section-label">أرسل تفاصيل موقعك</span><h2>اطلب {service.short}</h2><p class="spaced-copy">جهّز المنطقة والمقاسات والصور. سنراجع إمكانية الخدمة ونتفق على التكلفة والموعد بعد الاطلاع على التفاصيل.</p><a href="/مناطق/" class="text-link">راجع مناطق الخدمة ←</a></div><QuoteRequest initialService={service.short} /></div></section>
  <section class="section"><div class="container"><h2>خدمات مرتبطة بشغلك</h2><div class="grid-3 mt-32">{related.map(item => <a class="core-service" href={`/خدماتنا/${item.slug}/`}><h3>{item.short}</h3><p>{item.intro}</p><span class="text-link">تفاصيل الخدمة ←</span></a>)}</div><div class="mt-24"><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">خدمة تخريم الخرسانة بالكور دريل ←</a></div></div></section>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Service','@id':`${url}#service`,name:service.name,description:service.description,url,provider:{'@id':`${Astro.site}#business`}})} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
<style>.service-checklist{list-style:disc;padding-right:22px;margin-top:20px;display:grid;gap:14px}.service-checklist li{font-size:.92rem;color:var(--text-body)}section[id],aside[id]{scroll-margin-top:100px}.section-header-wide{max-width:820px}.installation-steps{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;list-style:none;padding:0;margin:32px 0 0;counter-reset:installation}.installation-steps li{position:relative;padding:27px 76px 25px 25px;border:1px solid var(--border-light);border-radius:12px;background:#fff;counter-increment:installation}.installation-steps li::before{content:counter(installation, decimal-leading-zero);position:absolute;right:24px;top:25px;color:var(--accent);font-weight:800;font-size:1.05rem}.installation-steps b{display:block;margin-bottom:11px;color:var(--primary-dark)}.installation-steps span{font-size:.92rem;color:var(--text-muted);line-height:1.8}.installation-steps a{color:var(--primary);font-weight:700}@media(max-width:800px){.installation-steps{grid-template-columns:1fr}.installation-steps li{padding-left:22px}}</style>
