---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from './QuoteRequest.astro';
import WorkGallery from './WorkGallery.astro';
import { services } from '../data/services';

interface Props {
  slug: string;
}

const service = services.find(item => item.slug === Astro.props.slug);
if (!service) throw new Error(`Unknown service: ${Astro.props.slug}`);

const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const pageUrl = new URL(`/خدماتنا/${service.slug}/`, siteUrl).href;
const isExhaustInstallation = service.slug === 'تركيب-وتأسيس-شفاطات';
const isConcreteSaw = service.slug === 'قص-الخرسانة-بالمنشار';

const exhaustInstallation = services.find(item => item.slug === 'تركيب-وتأسيس-شفاطات')!;
const related = service.slug === 'فتحات-الغاز-والشفاطات'
  ? [exhaustInstallation, ...services.filter(item => item.slug !== service.slug && item.slug !== exhaustInstallation.slug)].slice(0, 3)
  : services.filter(item => item.slug !== service.slug).slice(0, 3);

const sawGallery = isConcreteSaw ? [
  { src: '/images/work-gallery/work-25-diamond-wall-saw-rail.webp', alt: 'منشار حائط ماسي على مسار لقص الخرسانة' },
  { src: '/images/work-gallery/work-18-diamond-wall-saw.webp', alt: 'منشار حائط ماسي لفتح الأبواب والنوافذ الخرسانية' },
  { src: '/images/work-gallery/work-19-wire-saw-industrial.webp', alt: 'منشار سلك ماسي داخل موقع صناعي' },
  { src: '/images/work-gallery/work-20-wire-saw-rail.webp', alt: 'معدات قص خرسانة بالسلك الماسي على مسار' },
  { src: '/images/work-gallery/work-23-wire-saw-demolition.webp', alt: 'معدات قص وتقطيع خرسانة مسلحة في موقع تعديل' },
  { src: '/images/work-gallery/work-24-wire-saw-outdoor.webp', alt: 'قص خرسانة مسلحة بالمنشار الماسي في موقع خارجي' },
] : [];

const exhaustGallery = isExhaustInstallation ? [
  { src: '/images/work-gallery/work-14-core-drill-vent.webp', alt: 'تجهيز مخرج دكت تهوية لشفاط المطبخ بالكور دريل' },
  { src: '/images/work-gallery/work-17-core-hole-wall.webp', alt: 'فتحة كور دائرية نظيفة لمرور مدخنة شفاط المطبخ' },
  { src: '/images/work-gallery/work-22-hilti-core-drill-wall.webp', alt: 'ماكينة كور دريل أثناء تنفيذ فتحة تهوية حائطية' },
] : [];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: service.name,
  serviceType: service.short,
  description: service.seoDescription,
  url: pageUrl,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: { '@type': 'Country', name: 'مصر' },
};
---

<Layout
  title={service.seoTitle}
  description={service.seoDescription}
  faqs={service.faqs}
  extraGraph={[serviceSchema]}
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <a href="/خدماتنا/">الخدمات</a><span>›</span>
        <span>{service.short}</span>
      </nav>
      <h1>{service.name} — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">{service.intro}</p>
      <div class="actions-row">
        <a href="tel:+201271940742" class="btn btn-primary">اتصل الآن <bdi dir="ltr">01271940742</bdi></a>
        <a href="#quote" class="btn btn-outline">اطلب تسعير الخدمة</a>
      </div>
      <nav class="banner-subnav" aria-label="أقسام الخدمة">
        <a href="#details">تفاصيل التنفيذ</a>
        <a href="#specs">جدول المواصفات</a>
        <a href="#scope">نطاق العمل والتسعير</a>
        <a href="#questions">الأسئلة الشائعة</a>
      </nav>
    </div>
  </header>

  <section class="section-surface" id="details">
    <div class="container split-wide-first">
      <div class="prose">
        <h2>{service.heading}</h2>
        {service.paragraphs.map(text => <p>{text}</p>)}
        <div class="actions-row">
          <a href={`/مقالات/${service.article}/`} class="text-link">{service.articleLabel} ←</a>
          {service.secondaryArticle && service.secondaryArticleLabel && (
            <a href={`/مقالات/${service.secondaryArticle}/`} class="text-link">{service.secondaryArticleLabel} ←</a>
          )}
        </div>
      </div>

      <aside class="card-muted" id="prepare">
        <h3>المعلومات المطلوبة قبل التنفيذ</h3>
        <ul class="bullet-list">
          {service.checklist.map(item => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section" id="specs">
    <div class="container">
      <div class="section-header">
        <span class="section-label">المواصفات الفنية</span>
        <h2>{service.specsHeading}</h2>
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th scope="col">البند / النوع</th>
              <th scope="col">المقاس أو المواصفة الفنية</th>
              <th scope="col">التطبيق الميداني</th>
            </tr>
          </thead>
          <tbody>
            {service.specs.map(row => (
              <tr>
                <td><strong>{row.item}</strong></td>
                <td>{row.diameterOrSpec}</td>
                <td>{row.application}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {isExhaustInstallation && (
    <section class="section-surface" aria-labelledby="exhaust-steps-h">
      <div class="container">
        <div class="section-header">
          <span class="section-label">مراحل التركيب والتأسيس</span>
          <h2 id="exhaust-steps-h">خطوات تركيب وتأسيس شفاط المطبخ أو الحمام بكفاءة سحب عالية</h2>
        </div>
        <div class="steps-grid-2">
          <div class="step-card">
            <span class="step-num">01</span>
            <h3>تحديد نوع الشفاط والموديل</h3>
            <p>شفاط مدخنة هرمية، بلت إن 60/90 سم، شباك وزجاج، أو حمام مخفي سقفي؛ لكل نوع وصلة دكت وتثبيت خاص به.</p>
          </div>
          <div class="step-card">
            <span class="step-num">02</span>
            <h3>رسم أقصر مسار للدكت والمدخنة</h3>
            <p>تقليل الانحناءات (الأكواع) واختيار قطر الدكت المطابق للجهاز يمنع ضعف السحب وارتفاع صوت الموتور.</p>
          </div>
          <div class="step-card">
            <span class="step-num">03</span>
            <h3>تنفيذ فتحة الكور عند الحاجة</h3>
            <p>في الحوائط الخرسانية أو المكسوة بالسيراميك ننفذ فتحة كور دائرية نظيفة عبر قسم <a class="text-link" href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز والشفاطات</a>.</p>
          </div>
          <div class="step-card">
            <span class="step-num">04</span>
            <h3>التثبيت واختبار طرد الهواء</h3>
            <p>تثبيت الشفاط والدكت وغطاء المخرج الخارجي واختبار مسار الهواء؛ مع تنبيه أن تمديدات الكهرباء ينفذها كهربائي مختص.</p>
          </div>
        </div>
        <div class="actions-row mt-24">
          <a href="/مقالات/kitchen-exhaust-brands/" class="text-link">مقارنة أفضل أنواع شفاطات المطبخ (توشيبا، فريش، بلت إن) ←</a>
          <a href="/مقالات/exhaust-fan-maintenance/" class="text-link">دليل صيانة وتنظيف فلتر شفاط المطبخ ←</a>
        </div>
      </div>
    </section>
  )}

  {sawGallery.length > 0 && (
    <WorkGallery
      title="معدات قص الخرسانة بالمنشار الماسي ومنشار السلك"
      description="نماذج لمناشير الحائط والسلك الماسي المستخدمة في فتح الأبواب والشبابيك وقص الخرسانة المسلحة."
      images={sawGallery}
    />
  )}

  {exhaustGallery.length > 0 && (
    <WorkGallery
      title="تجهيز فتحات ومخارج دكت الشفاطات بالكور دريل"
      description="أعمال تخريم دائرية نظيفة لمخارج مداخن الشفاطات في الحوائط الخرسانية."
      images={exhaustGallery}
    />
  )}

  <section class="section-alt" id="scope">
    <div class="container grid-2">
      <div class="card">
        <span class="section-label">حدود ونطاق العمل</span>
        <h2>ما الذي يشمله عرض السعر؟</h2>
        <p class="spaced-copy">{service.boundaries}</p>
      </div>
      <div class="card">
        <span class="section-label">التسعير الاسترشادي</span>
        <h2>كيف تُحسب تكلفة الخدمة؟</h2>
        <p class="spaced-copy">{service.pricing}</p>
        <a href="/اسعار-الخدمات/" class="text-link">جدول الأسعار الاسترشادية الكامل ←</a>
      </div>
    </div>
  </section>

  <section class="section-surface" id="questions">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">الأسئلة الشائعة</span>
        <h2>أسئلة متكررة حول {service.short}</h2>
        <p class="spaced-copy">إجابات فنية مباشرة لمساعدتك على تجهيز الموقع وتحديد المقاس الصحيح.</p>
        <a href="/الاسئلة-الشائعة/" class="text-link">جميع الأسئلة الشائعة ←</a>
      </div>
      <div class="native-faq">
        {service.faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt" id="quote">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">حجز وتسعير</span>
        <h2>اطلب خدمة {service.short} الآن</h2>
        <p class="spaced-copy">أرسل المنطقة والمقاسات أو اتصل على <a class="text-link" href="tel:+201271940742"><bdi dir="ltr">01271940742</bdi></a> لتأكيد التكلفة وأقرب موعد متاح.</p>
        <a href="/مناطق/" class="text-link">استعرض مناطق الخدمة في مصر ←</a>
      </div>
      <QuoteRequest initialService={service.short} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading-row">
        <div>
          <span class="section-label">خدمات مرتبطة</span>
          <h2>أقسام أخرى قد تحتاجها في موقعك</h2>
        </div>
        <a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تخريم الخرسانة بالكور دريل ←</a>
      </div>
      <div class="grid-3">
        {related.map(item => (
          <a class="service-card" href={`/خدماتنا/${item.slug}/`}>
            <h3>{item.short}</h3>
            <p>{item.intro}</p>
            <span class="text-link">تفاصيل الخدمة ←</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
