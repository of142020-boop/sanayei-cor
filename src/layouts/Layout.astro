      { "@type": "AdministrativeArea", name: "البحر الأحمر والغردقة" },
      { "@type": "AdministrativeArea", name: "المنيا" },
      { "@type": "AdministrativeArea", name: "أسيوط" },
      { "@type": "AdministrativeArea", name: "سوهاج" },
      { "@type": "AdministrativeArea", name: "قنا" },
      { "@type": "Country", name: "مصر" },
    ],
    contactPoint: [
      {
        "@type": "ContactPoint",
        telephone: "+201271940742",
        contactType: "تخريم الخرسانة وفتحات الكور",
        areaServed: "EG",
        availableLanguage: ["Arabic"],
      },
      {
        "@type": "ContactPoint",
        telephone: "+201271940742",
        contactType: "قص الخرسانة بالمنشار الماسي وتزريع الأشاير",
        areaServed: "EG",
        availableLanguage: ["Arabic"],
      },
      {
        "@type": "ContactPoint",
        telephone: "+201271940742",
        contactType: "تركيب وتأسيس شفاطات المطابخ والحمامات",
        areaServed: "EG",
        availableLanguage: ["Arabic"],
      },
    ],
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "خدمات صنايعي كور للخرسانة والتمديدات",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "تخريم خرسانة وفتحات كور بالكور دريل",
            url: `${siteUrl}/خدماتنا/تخريم-خرسانة/`,
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
