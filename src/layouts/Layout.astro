      property="og:image:alt"
      content="صنايعي كور — تخريم وقص الخرسانة بالكور دريل والمنشار الماسي"
    />
    <meta property="og:site_name" content="صنايعي كور" />
    <meta property="og:locale" content="ar_EG" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${socialImage}`} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="ar-eg" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Unified Entity Graph Schema (GEO + Technical SEO) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": graphNodes,
      })}
    />
  </head>

