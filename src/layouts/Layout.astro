---
import "../styles/global.css";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  dateModified?: string;
  faqs?: FaqItem[] | [string, string][];
  extraGraph?: Record<string, unknown>[];
}

const {
  title,
  description = "صنايعي كور لتخريم وقص الخرسانة بالكور دريل والمنشار الماسي في القاهرة والجيزة ومصر: فتحات تكييف وغاز وسباكة وشفاطات. اتصل 01271940742.",
  canonical,
  ogImage = "/images/social-card.png",
  noindex = false,
  dateModified = "2026-11-23",
  faqs = [],
  extraGraph = [],
} = Astro.props;

const siteUrl = Astro.site?.origin || "https://sanayeicor.com";
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const canonicalUrl = new URL(
  canonical || `${Astro.url.pathname.replace(/\/$/, "")}/`,
  siteUrl,
).href;
const socialImage = ogImage.startsWith("/")
  ? ogImage
  : "/images/social-card.png";
const currentPath = decodeURIComponent(Astro.url.pathname);
const pathParts = currentPath.split("/").filter(Boolean);

const segmentLabels: Record<string, string> = {
  خدماتنا: "الخدمات",
  مناطق: "مناطق الخدمة",
  مقالات: "المدونة والأدلة",
  "اسعار-الخدمات": "أسعار الخدمات",
  "الاسئلة-الشائعة": "الأسئلة الشائعة",
  "نبذة-عنا": "عن صنايعي كور",
  "اتصل-بنا": "اتصل بنا",
};

const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "الرئيسية", item: `${siteUrl}/` },
  ...pathParts.map((part, index) => ({
    "@type": "ListItem",
    position: index + 2,
    name:
      index === pathParts.length - 1
        ? title.split("|")[0].split("—")[0].trim()
        : segmentLabels[part] || part.replaceAll("-", " "),
    item: new URL(`/${pathParts.slice(0, index + 1).join("/")}/`, siteUrl).href,
  })),
];

const normalizedFaqs: FaqItem[] = faqs.map((item) =>
  Array.isArray(item) ? { question: item[0], answer: item[1] } : item,
);

const graphNodes: Record<string, unknown>[] = [
  {
    "@type": ["Organization", "LocalBusiness", "HomeAndConstructionBusiness"],
    "@id": orgId,
    name: "صنايعي كور",
    alternateName: "Sanayei Cor",
    description:
      "مقاول متخصص في تخريم الخرسانة المسلحة بالكور دريل الماسي، وقص الخرسانة بالمنشار الماسي، وفتحات التكييف والغاز والسباكة، وتزريع أشاير الحديد، وتركيب الشفاطات في مصر.",
    url: `${siteUrl}/`,
    telephone: "+201271940742",
    priceRange: "200–1300 EGP",
    hasMap: 'https://share.google/O2IWRCj6q6r7nxk9D',
    sameAs: ['https://share.google/O2IWRCj6q6r7nxk9D'],
    logo: {
      "@type": "ImageObject",
      url: `${siteUrl}/images/sanayei-cor-logo.png`,
      width: 512,
      height: 512,
    },
    image: `${siteUrl}${socialImage}`,
    address: {
      "@type": "PostalAddress",
      addressLocality: "القاهرة",
      addressRegion: "القاهرة الكبرى",
      addressCountry: "EG",
    },
    knowsAbout: [
      "تخريم الخرسانة بالكور دريل الماسي",
      "عمل فتحات كور في الجدران والأسقف",
      "قص الخرسانة بالمنشار الماسي الجداري ومنشار السلك",
      "فتحات التكييف السبليت والمركزي والتهوية",
      "فتحات الغاز الطبيعي ومداخن السخانات",
      "تركيب وتأسيس شفاطات المطابخ والحمامات والدكت",
      "فتحات السباكة والصرف الصحي في الفلات سلاب",
      "تزريع أشاير الحديد بالإيبوكسي الكيميائي",
    ],
    areaServed: [
      { "@type": "City", name: "القاهرة" },
      { "@type": "City", name: "الجيزة" },
      { "@type": "City", name: "التجمع الخامس والقاهرة الجديدة" },
      { "@type": "City", name: "6 أكتوبر والشيخ زايد" },
      { "@type": "City", name: "الإسكندرية" },
      { "@type": "AdministrativeArea", name: "القليوبية" },
      { "@type": "AdministrativeArea", name: "الشرقية" },
      { "@type": "AdministrativeArea", name: "المنوفية" },
      { "@type": "AdministrativeArea", name: "الغربية" },
      { "@type": "AdministrativeArea", name: "الدقهلية والمنصورة" },
      { "@type": "AdministrativeArea", name: "الإسماعيلية" },
      { "@type": "AdministrativeArea", name: "السويس والعين السخنة" },
      { "@type": "AdministrativeArea", name: "بورسعيد" },
      { "@type": "AdministrativeArea", name: "دمياط" },
