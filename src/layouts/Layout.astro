            url: `${siteUrl}/خدماتنا/فتحات-الغاز-والشفاطات/`,
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "تركيب وتأسيس شفاطات المطابخ والحمامات",
            url: `${siteUrl}/خدماتنا/تركيب-وتأسيس-شفاطات/`,
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "فتحات السباكة والصرف الصحي بالكور",
            url: `${siteUrl}/خدماتنا/فتحات-سباكة/`,
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "تزريع أشاير الحديد بالإيبوكسي الكيميائي",
            url: `${siteUrl}/خدماتنا/تزريع-اشاير-حديد/`,
          },
        },
      ],
    },
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    url: `${siteUrl}/`,
    name: "صنايعي كور",
    inLanguage: "ar-EG",
    description:
      "الموقع الرسمي لمقاول صنايعي كور المتخصص في تخريم وقص الخرسانة المسلحة بالكور دريل والمنشار الماسي في مصر.",
    publisher: { "@id": orgId },
  },
  {
    "@type": "WebPage",
    "@id": `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    description,
    inLanguage: "ar-EG",
    dateModified,
    isPartOf: { "@id": websiteId },
    about: { "@id": orgId },
    primaryImageOfPage: {
      "@type": "ImageObject",
      contentUrl: `${siteUrl}${socialImage}`,
    },
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [
        "h1",
        ".hero-lead",
        ".banner-lead",
        ".quick-answers",
        ".native-faq",
      ],
    },
  },
];

if (pathParts.length > 0 && !noindex) {
  graphNodes.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    itemListElement: breadcrumbItems,
  });
}

if (normalizedFaqs.length > 0 && !noindex) {
  graphNodes.push({
    "@type": "FAQPage",
    "@id": `${canonicalUrl}#faq`,
    mainEntity: normalizedFaqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  });
}

for (const node of extraGraph) {
  graphNodes.push(node);
}

const navLinks = [
  { href: "/", label: "الرئيسية" },
  { href: "/خدماتنا/", label: "الخدمات" },
  { href: "/اسعار-الخدمات/", label: "الأسعار" },
  { href: "/مناطق/", label: "المناطق" },
  { href: "/مقالات/", label: "الأدلة" },
  { href: "/نبذة-عنا/", label: "عن الشركة" },
  { href: "/اتصل-بنا/", label: "اتصل بنا" },
];
