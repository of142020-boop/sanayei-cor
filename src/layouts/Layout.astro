---
import '../styles/global.css';
import { existsSync } from 'node:fs';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  navbarStyle?: 'transparent' | 'solid';
}

const {
  title,
  description = 'صنايعي كور لخدمات تخريم الخرسانة وفتحات الكور دريل وقص الخرسانة. اتصل الآن 01271940742 لطلب عرض سعر ومراجعة تفاصيل موقعك.',
  canonical,
  ogImage = '/images/social-card.png',
  noindex = false,
  navbarStyle = 'transparent',
} = Astro.props;

const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const canonicalUrl = new URL(canonical || `${Astro.url.pathname.replace(/\/$/, '')}/`, siteUrl).href;
const socialImage = ogImage.startsWith('/') && existsSync(`${process.cwd()}/public${ogImage}`) ? ogImage : '/images/social-card.png';

const currentPath = decodeURIComponent(Astro.url.pathname);

const pathParts = currentPath.split('/').filter(Boolean);
const breadcrumbItems = [{ '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${siteUrl}/` }, ...pathParts.map((part, index) => ({ '@type': 'ListItem', position: index + 2, name: index === pathParts.length - 1 ? title.split('|')[0].trim() : part.replaceAll('-', ' '), item: new URL(`/${pathParts.slice(0,index+1).join('/')}/`, siteUrl).href }))];

const navLinks = [
  { href: '/', label: 'الرئيسية' },
  { href: '/خدماتنا/', label: 'الخدمات' },
  { href: '/اسعار-الخدمات/', label: 'أسعارنا' },
  { href: '/مقالات/', label: 'المدونة' },
  { href: '/مناطق/', label: 'المناطق' },
  { href: '/نبذة-عنا/', label: 'عن صنايعي كور' },
  { href: '/اتصل-بنا/', label: 'اتصل بنا' },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="author" content="صنايعي كور" />
    <meta name="theme-color" content="#e43a15" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }

    {pathParts.length > 0 && !noindex && <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbItems})} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${socialImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="صنايعي كور - تخريم الخرسانة بالكور دريل" />
    <meta property="og:site_name" content="صنايعي كور" />
    <meta property="og:locale" content="ar_EG" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${socialImage}`} />

    <!-- Hreflang (Arabic Egypt) -->
    <link rel="alternate" hreflang="ar-eg" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Schema: LocalBusiness + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["LocalBusiness", "ProfessionalService"],
          "@id": `${siteUrl}/#business`,
          "name": "صنايعي كور",
          "alternateName": "Sanayei Cor",
          "description": "متخصصون في قص وتخريم الخرسانة المسلحة بالكور دريل والمنشار الماسي في مناطق الخدمة الموضحة بالموقع",
          "url": siteUrl,
          "telephone": "+201271940742",
          "image": `${siteUrl}${socialImage}`,
          "knowsAbout": [
            "تخريم الخرسانة بالكور دريل",
            "قص الخرسانة بالمنشار الماسي",
            "فتحات التكييف والتهوية",
            "فتحات الغاز والشفاطات",
            "فتحات السباكة والصرف",
            "تزريع أشاير الحديد"
          ],
          "areaServed": [
            { "@type": "City", "name": "القاهرة" },
            { "@type": "City", "name": "الجيزة" },
            { "@type": "City", "name": "التجمع الخامس" },
            { "@type": "City", "name": "6 أكتوبر" },
            { "@type": "City", "name": "الشيخ زايد" },
            { "@type": "City", "name": "الإسكندرية" },
            { "@type": "State", "name": "مصر" }
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+201271940742",
            "contactType": "customer service",
            "availableLanguage": "Arabic"
          },
          "hasOfferCatalog": {
            "@type": "OfferCatalog",
            "name": "خدمات صنايعي كور",
            "itemListElement": [
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "تخريم خرسانة بالكور دريل" }},
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "قص خرسانة بالمنشار الماسي" }},
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحات غاز طبيعي بالكور" }},
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحات تكييف وتهوية بالكور" }},
              { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحات سباكة وصرف صحي بالكور" }}
            ]
          }
        },
        {
          "@type": "WebSite",
          "@id": `${siteUrl}/#website`,
          "url": siteUrl,
          "name": "صنايعي كور",
          "inLanguage": "ar-EG",
          "description": "الموقع الرسمي لصنايعي كور المتخصصين في تخريم وقص الخرسانة في مصر",
          "publisher": { "@id": `${siteUrl}/#business` }
        },
        {
          "@type": "WebPage",
          "@id": `${canonicalUrl}#webpage`,
          "url": canonicalUrl,
          "name": title,
          "description": description,
          "inLanguage": "ar-EG",
          "isPartOf": { "@id": `${siteUrl}/#website` },
          "about": { "@id": `${siteUrl}/#business` },
          "primaryImageOfPage": { "@type": "ImageObject", "contentUrl": `${siteUrl}${socialImage}` }
        }
      ]
    })} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">انتقل إلى المحتوى</a>
    <!-- Navbar -->
    <header class="navbar scrolled" id="navbar">
      <div class="container">
        <div class="nav-inner">
          <a href="/" class="nav-logo" aria-label="صنايعي كور - الصفحة الرئيسية">
          <img class="brand-mark brand-mark-nav" src="/images/sanayei-cor-logo.svg" width="44" height="44" alt="" />
            <span>صنايعي <strong style="color:var(--primary)">كور</strong></span>
          </a>

          <nav class="nav-links" id="navLinks" aria-label="القائمة الرئيسية">
            {navLinks.map(link => (
              <a
                href={link.href}
                class={currentPath === link.href || (currentPath.startsWith(link.href) && link.href !== '/') ? 'active' : ''}
              >
                {link.label}
              </a>
            ))}
          </nav>

          <div class="nav-cta">
            <a href="tel:+201271940742" class="nav-phone-link" aria-label="اتصل بنا">01271940742</a>
            <a href="tel:+201271940742" class="btn btn-primary" style="padding:10px 20px;font-size:.9rem;">اتصل الآن</a>
            <button class="nav-toggle" id="navToggle" aria-label="فتح/إغلاق القائمة" aria-expanded="false" aria-controls="navLinks">
              <span></span><span></span><span></span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer" itemscope itemtype="https://schema.org/WPFooter">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div class="footer-logo">
            <img class="brand-mark brand-mark-footer" src="/images/sanayei-cor-logo.svg" width="38" height="38" alt="" />
              <span>صنايعي <strong style="color:var(--primary)">كور</strong></span>
            </div>
            <p>صنايعي كور لخدمات تخريم الخرسانة بالكور دريل، وفتحات الغاز والتكييف والسباكة، وقص الخرسانة بالمنشار. تواصل لتحديد متطلبات شغلك وطلب عرض سعر.</p>
            
          </div>

          <div class="footer-col">
            <h4>خدماتنا</h4>
            <div class="footer-links">
              <a href="/خدماتنا/تخريم-خرسانة/">تخريم خرسانة بالكور</a>
              <a href="/خدماتنا/قص-الخرسانة-بالمنشار/">قص خرسانة بالمنشار</a>
              <a href="/خدماتنا/فتحات-الغاز-والشفاطات/">فتحات الغاز والشفاطات</a>
              <a href="/خدماتنا/تزريع-اشاير-حديد/">تزريع اشاير حديد وايبوكسي</a>
              <a href="/خدماتنا/فتحات-تكييف/">فتحات تكييف وتهوية</a>
            </div>
          </div>

          <div class="footer-col">
            <h4>مناطق الخدمة</h4>
            <div class="footer-links">
              <a href="/مناطق/التجمع-الخامس/">صنايعي كور التجمع</a>
              <a href="/مناطق/اكتوبر-وزايد/">صنايعي كور أكتوبر وزايد</a>
              <a href="/مناطق/القاهرة/">صنايعي كور القاهرة</a>
              <a href="/مناطق/الجيزة/">صنايعي كور الجيزة</a>
              <a href="/مناطق/الإسكندرية/">صنايعي كور الإسكندرية</a>
            </div>
          </div>

          <div class="footer-col">
            <h4>تواصل معنا</h4>
            <div class="footer-contact-list">
              <div class="footer-contact-item">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="var(--primary)"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.06 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92v2z"/></svg>
                <div>
                  <a href="tel:+201271940742" style="color:var(--primary);font-weight:700">01271940742</a>
                  <small style="display:block;color:var(--text-muted)">اتصل لتأكيد الوقت المتاح</small>
                </div>
              </div>
              <div class="footer-contact-item">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="#25D366"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <div>
                  <a href="https://wa.me/201271940742" style="color:var(--primary);font-weight:700" target="_blank" rel="noopener noreferrer">واتساب</a>
                  <small style="display:block;color:var(--text-muted)">أرسل صور الموقع والمقاسات</small>
                </div>
              </div>
              <div class="footer-contact-item">
                
                <span>تواصل لتأكيد تغطية عنوانك</span>
              </div>
            </div>
          </div>
        </div><!-- /footer-grid -->
      </div><!-- /container -->
    </footer>
    <div class="footer-bottom">
      <div class="container">
        <div class="footer-bottom-inner">
          <p>&copy; {new Date().getFullYear()} صنايعي كور — جميع الحقوق محفوظة</p>
          <div class="footer-links-row">
            <a href="/نبذة-عنا/">عن صنايعي كور</a>
            <a href="/اسعار-الخدمات/">أسعار خدماتنا</a>
            <a href="/مقالات/">المدونة والمقالات</a>
            <a href="/الاسئلة-الشائعة/">الأسئلة الشائعة</a>
            <a href="/اتصل-بنا/">اتصل بنا</a>
          </div>
        </div>
      </div>
    </div>



    <div class="mobile-contact" aria-label="تواصل سريع">
      <a class="mobile-contact-action mobile-contact-call" href="tel:+201271940742" aria-label="اتصل الآن على 01271940742">
        <span class="mobile-contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.06 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92v2z"/></svg>
        </span>
        <span class="mobile-contact-copy"><strong>اتصل الآن</strong><small dir="ltr">01271940742</small></span>
      </a>
      <a class="mobile-contact-action mobile-contact-whatsapp" href="https://wa.me/201271940742" target="_blank" rel="noopener noreferrer" aria-label="راسلنا على واتساب لطلب عرض سعر">
        <span class="mobile-contact-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20.52 3.48A11.86 11.86 0 0012.08 0C5.53 0 .2 5.33.2 11.88c0 2.09.55 4.13 1.59 5.92L.1 24l6.37-1.67a11.86 11.86 0 005.61 1.43h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.23-6.15-3.45-8.4zM12.08 21.75a9.84 9.84 0 01-5.02-1.37l-.36-.21-3.78.99 1.01-3.68-.24-.38a9.82 9.82 0 01-1.5-5.22c0-5.43 4.42-9.85 9.86-9.85 2.63 0 5.1 1.02 6.96 2.89a9.78 9.78 0 012.88 6.96c0 5.43-4.42 9.87-9.81 9.87zm5.4-7.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.47a9.04 9.04 0 01-1.66-2.07c-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.91-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.5.71.31 1.26.5 1.69.64.71.23 1.35.2 1.86.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/></svg>
        </span>
        <span class="mobile-contact-copy"><strong>واتساب</strong><small>اطلب عرض سعر</small></span>
      </a>
    </div>
    <script>
      // Navbar scroll effect
      const navbar = document.getElementById('navbar');
      const navToggle = document.getElementById('navToggle');
      const navLinks = document.getElementById('navLinks');

      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          navbar?.classList.add('scrolled');
        } else {
          navbar?.classList.remove('scrolled');
        }
      });

      // Mobile nav toggle
      navToggle?.addEventListener('click', () => {
        navLinks?.classList.toggle('open');
        const isOpen = navLinks?.classList.contains('open');
        navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && navLinks?.classList.contains('open')) {
          navLinks.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
          navToggle?.focus();
        }
      });

      // FAQ accordion
      document.querySelectorAll('.faq-question').forEach(question => {
        const toggle = () => {
          const item = question.closest('.faq-item');
          const isOpen = item?.classList.contains('open');
          document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
          if (!isOpen) item?.classList.add('open');
          document.querySelectorAll('.faq-question').forEach(q => q.setAttribute('aria-expanded', q.closest('.faq-item')?.classList.contains('open') ? 'true' : 'false'));
        };
        question.addEventListener('click', toggle);
        question.addEventListener('keydown', (event) => {
          if (event instanceof KeyboardEvent && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); toggle(); }
        });
      });
    </script>
  </body>
</html>
