---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = (await getCollection("blog")).filter(post => post.id !== entry.id && post.data.tags.some(tag => entry.data.tags.includes(tag))).slice(0,3);
---

<Layout 
  title={entry.data.title} 
  description={entry.data.description} 
  ogImage={entry.data.image}
  navbarStyle="solid"
>
  <div class="page-header" style="background: linear-gradient(135deg, var(--dark) 0%, #1a252f 100%); padding-top: 150px; padding-bottom: 60px; color: white; text-align: center;">
    <div class="container">
      <div style="display:flex; justify-content:center; gap:10px; margin-bottom:20px; flex-wrap:wrap;">
        {entry.data.tags.map(tag => (
          <span style="background-color: var(--primary); color: white; padding: 5px 15px; border-radius: 20px; font-size: 0.85rem; font-weight: bold;">{tag}</span>
        ))}
      </div>
      <h1 style="font-size: 2.5rem; line-height: 1.4; margin-bottom: 20px; max-width: 800px; margin-left: auto; margin-right: auto;">{entry.data.title}</h1>
      <div style="color: #ccc; font-size: 1rem;">
        <span>الكاتب: {entry.data.author}</span> &bull; 
        <span>نُشر: <time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().split('T')[0]}</time></span>
        {entry.data.updatedDate && <span> · آخر تحديث: <time datetime={entry.data.updatedDate.toISOString()}>{entry.data.updatedDate.toISOString().split('T')[0]}</time></span>}
      </div>
    </div>
  </div>

  <article class="section blog-content" style="background-color: #fff;">
    <div class="container" style="max-width: 800px;">
      {entry.data.image && (
        <img src={entry.data.image} alt={entry.data.title} style="width: 100%; border-radius: 12px; margin-bottom: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.1);" />
      )}
      
      <nav aria-label="محتوى المقال" class="card" style="margin-bottom:32px"><strong>في هذا الدليل</strong><ul style="display:grid;gap:8px;margin-top:12px">{headings.filter(heading => heading.depth === 2).map(heading => <li><a class="text-link" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>
      <div class="prose" style="font-size: 1.1rem; line-height: 1.8; color: #333;">
        <Content />
      </div>

      <div class="mt-32"><a class="text-link" href="/#quote">جهّز طلب عرض سعر على واتساب ←</a></div>
      {related.length > 0 && <aside class="card mt-32"><h2 style="font-size:1.3rem">أدلة مرتبطة</h2><ul style="display:grid;gap:12px;margin-top:16px">{related.map(post => <li><a class="text-link" href={`/مقالات/${post.id}/`}>{post.data.title}</a></li>)}</ul></aside>}
      <div style="margin-top: 60px; padding: 40px; background: linear-gradient(to left, rgba(228,58,21,0.05), rgba(228,58,21,0.1)); border-radius: 12px; text-align: center; border: 2px dashed var(--primary);">
        <h3 style="color: var(--dark); margin-bottom: 15px; font-size: 1.5rem;">هل تحتاج إلى مساعدة احترافية؟</h3>
        <p style="margin-bottom: 25px; color: var(--text-muted);">نحن في صنايعي كور نوفر لك أحدث المعدات وأفضل الفنيين لتنفيذ كافة أعمال تخريم وقص الخرسانة بأعلى جودة وبأفضل الأسعار.</p>
        <a href="tel:+201271940742" class="btn btn-primary" style="font-size: 1.2rem; padding: 15px 40px; border-radius: 30px; box-shadow: 0 5px 15px rgba(228,58,21,0.3);">
          اتصل بنا الآن 01271940742
        </a>
      </div>
    </div>
  </article>

  <style is:global>
    .prose h2 {
      font-size: 1.8rem;
      color: var(--dark);
      margin-top: 40px;
      margin-bottom: 20px;
      border-right: 4px solid var(--primary);
      padding-right: 15px;
    }
    .prose h3 {
      font-size: 1.4rem;
      color: #2c3e50;
      margin-top: 30px;
      margin-bottom: 15px;
    }
    .prose p {
      margin-bottom: 20px;
    }
    .prose ul, .prose ol {
      margin-bottom: 20px;
      padding-right: 20px;
    }
    .prose li {
      margin-bottom: 10px;
    }
    .prose strong {
      color: var(--primary);
      font-weight: 700;
    }
  </style>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'BlogPosting',headline:entry.data.title,description:entry.data.description,datePublished:entry.data.date.toISOString(),dateModified:(entry.data.updatedDate || entry.data.date).toISOString(),inLanguage:'ar-EG',mainEntityOfPage:new URL(Astro.url.pathname,Astro.site).href,author:{'@type':'Organization',name:entry.data.author,url:new URL('/نبذة-عنا/',Astro.site).href},publisher:{'@id':`${Astro.site}#business`}})} />
</Layout>
