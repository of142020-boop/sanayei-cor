---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const allPosts = await getCollection('blog');
const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const pageUrl = new URL(`/مقالات/${entry.id}/`, siteUrl).href;

const byTag = allPosts.filter(
  post => post.id !== entry.id && post.data.tags.some(tag => entry.data.tags.includes(tag))
);
const fallbackPosts = allPosts.filter(
  post => post.id !== entry.id && !byTag.some(item => item.id === post.id)
);
const related = [...byTag, ...fallbackPosts].slice(0, 3);

const articleImage = entry.data.image ? new URL(entry.data.image, siteUrl).href : `${siteUrl}/images/social-card.png`;
const modifiedIso = (entry.data.updatedDate || entry.data.date).toISOString();

const blogPostingSchema = {
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  dateModified: modifiedIso,
  inLanguage: 'ar-EG',
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  author: {
    '@type': 'Organization',
    name: entry.data.author,
    '@id': `${siteUrl}/#organization`,
  },
  publisher: { '@id': `${siteUrl}/#organization` },
  image: {
    '@type': 'ImageObject',
    url: articleImage,
    width: entry.data.image ? 1600 : 1200,
    height: entry.data.image ? 1067 : 630,
  },
  keywords: entry.data.tags.join(', '),
  about: entry.data.tags.map(name => ({ '@type': 'Thing', name })),
};
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={entry.data.image}
  dateModified={modifiedIso.slice(0, 10)}
  faqs={entry.data.faqs}
  extraGraph={[blogPostingSchema]}
>
  <header class="page-banner page-banner-dark">
    <div class="container-narrow">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <a href="/مقالات/">الأدلة الفنية</a><span>›</span>
        <span>{entry.data.tags[0] || 'دليل فني'}</span>
      </nav>
      <div class="tag-list">
        {entry.data.tags.map(tag => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
      <h1>{entry.data.title}</h1>
      <div class="banner-meta">
        <span>المؤلف: {entry.data.author}</span>
        <span>·</span>
        <span>تاريخ النشر: <time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().split('T')[0]}</time></span>
        {entry.data.updatedDate && (
          <>
            <span>·</span>
            <span>آخر تحديث: <time datetime={entry.data.updatedDate.toISOString()}>{entry.data.updatedDate.toISOString().split('T')[0]}</time></span>
          </>
        )}
      </div>
    </div>
  </header>

  <article class="section-surface">
    <div class="container-narrow">
      {entry.data.image && (
        <img
          src={entry.data.image}
          alt={entry.data.title}
          width="1600"
          height="1067"
          class="article-cover"
          fetchpriority="high"
        />
      )}

      {headings.filter(h => h.depth === 2).length > 0 && (
        <nav aria-label="محتوى الدليل" class="article-toc">
          <strong>محاور هذا الدليل</strong>
          <ul>
            {headings.filter(h => h.depth === 2).map(heading => (
              <li><a class="text-link" href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {entry.data.faqs.length > 0 && (
        <section class="mt-32" aria-labelledby="article-faq-h">
          <h2 id="article-faq-h" class="mb-16">أسئلة شائعة حول موضوع الدليل</h2>
          <div class="native-faq">
            {entry.data.faqs.map(faq => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <div class="card-muted mt-32">
        <span class="section-label">تنفيذ فوري في موقعك</span>
        <h3>تحتاج تنفيذ فتحات كور أو قص خرسانة أو تركيب شفاط بدقة؟</h3>
        <p class="spaced-copy">
          فريق صنايعي كور ينفذ الأعمال بالمعدات الماسية بدون تكسير أو شروخ في القاهرة والجيزة والمدن الجديدة والمحافظات.
        </p>
        <div class="actions-row">
          <a href="tel:+201271940742" class="btn btn-primary">اتصل الآن <bdi dir="ltr">01271940742</bdi></a>
          <a href="/#quote" class="btn btn-outline">اطلب تسعيرًا عبر واتساب</a>
          <a href="/اسعار-الخدمات/" class="btn btn-outline">جدول الأسعار الاسترشادية</a>
        </div>
      </div>

      {related.length > 0 && (
        <aside class="mt-32" aria-labelledby="related-guides-h">
          <h2 id="related-guides-h" class="mb-16">أدلة فنية مرتبطة</h2>
          <div class="grid-3">
            {related.map(post => (
              <a class="service-card" href={`/مقالات/${post.id}/`}>
                <h3>{post.data.title}</h3>
                <span class="text-link">اقرأ الدليل ←</span>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </article>
</Layout>
