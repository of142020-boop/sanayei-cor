---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
allPosts.sort((a, b) => (b.data.updatedDate || b.data.date).valueOf() - (a.data.updatedDate || a.data.date).valueOf());

const title = 'الأدلة الفنية لتخريم وقص الخرسانة والشفاطات | 01271940742';
const description = 'أدلة عملية في تخريم الخرسانة بالكور دريل، قص الخرسانة بالمنشار الماسي، مقاسات فتحات الغاز والتكييف والسباكة، وتركيب الشفاطات في مصر. 01271940742.';
---

<Layout title={title} description={description}>
  <header class="page-banner page-banner-dark">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <span>الأدلة الفنية والمدونة</span>
      </nav>
      <h1>الأدلة الفنية لتخريم وقص الخرسانة وتأسيس الشفاطات</h1>
      <p class="banner-lead">
        مراجع تطبيقية تشرح اختيار الأقطار، مقارنة الكور دريل بالمنشار الماسي، تخريم السيراميك والرخام بدون كسور، وأسس تأسيس شفاطات المطابخ والحمامات في مصر.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {allPosts.map(post => (
          <article class="blog-card">
            <a href={`/مقالات/${post.id}/`}>
              {post.data.image && (
                <div class="blog-card-media">
                  <img
                    src={post.data.image}
                    alt={post.data.title}
                    width="1600"
                    height="1067"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="blog-card-body">
                <div class="tag-list">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <div class="blog-card-foot">
                  <time datetime={(post.data.updatedDate || post.data.date).toISOString()}>
                    {(post.data.updatedDate || post.data.date).toISOString().split('T')[0]}
                  </time>
                  <span class="text-link">اقرأ الدليل ←</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
