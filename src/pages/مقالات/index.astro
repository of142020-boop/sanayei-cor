---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
// Sort by date descending
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = "دليل ومعلومات | صنايعي كور لتخريم وقص الخرسانة";
const description = "مقالات ومعلومات هامة عن طرق تخريم الخرسانة، أسعار ماكينات الكور دريل، وكيفية تركيب الشفاطات وقص الجدران بالليزر والمنشار الماسي.";
---

<Layout title={title} description={description} navbarStyle="solid">
  <div class="page-header" style="background: linear-gradient(135deg, var(--dark) 0%, #1a252f 100%); padding-top: 150px; padding-bottom: 80px; color: white; text-align: center;">
    <div class="container">
      <h1 style="font-size: 3rem; margin-bottom: 20px;">المدونة والمقالات</h1>
      <p style="font-size: 1.2rem; max-width: 700px; margin: 0 auto; color: #ccc;">كل ما تريد معرفته عن تقنيات قص وتخريم الخرسانة، والمعدات، وأسعار الخدمات في السوق المصري.</p>
    </div>
  </div>

  <section class="section" style="background-color: #f8f9fa;">
    <div class="container">
      <div class="grid-3" style="gap: 30px;">
        {allPosts.map(post => (
          <article class="blog-card" style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
            <a href={`/مقالات/${post.id}/`} style="display: block; text-decoration: none; color: inherit;">
              {post.data.image && (
                <div style="height: 220px; overflow: hidden;">
                  <img src={post.data.image} alt={post.data.title} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" />
                </div>
              )}
              <div style="padding: 25px;">
                <div style="display:flex; gap:10px; margin-bottom:15px; flex-wrap:wrap;">
                  {post.data.tags.map(tag => (
                    <span style="background-color: rgba(228, 58, 21, 0.1); color: var(--primary); padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: bold;">{tag}</span>
                  ))}
                </div>
                <h2 style="font-size: 1.3rem; margin-bottom: 15px; color: var(--dark); line-height: 1.4;">{post.data.title}</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">
                  {post.data.description}
                </p>
                <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #eee; padding-top: 15px;">
                  <span style="font-size: 0.85rem; color: #888;">{post.data.date.toISOString().split('T')[0]}</span>
                  <span style="color: var(--primary); font-weight: bold; font-size: 0.9rem;">اقرأ المزيد &larr;</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blog-card:hover {
      transform: translateY(-10px);
    }
    .blog-card:hover img {
      transform: scale(1.05);
    }
  </style>
</Layout>
