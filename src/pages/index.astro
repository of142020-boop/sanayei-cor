---
import Layout from '../layouts/Layout.astro';
const title = "صنايعي كور | تخريم وقص الخرسانة المسلحة في مصر | 01055550195";
const description = "صنايعي كور متخصص في تخريم الخرسانة بالكور دريل وقص الخرسانة المسلحة بالمنشار الماسي. فتحات غاز وتكييف وسباكة في جميع محافظات مصر — اتصل الآن 01055550195";
---
<Layout title={title} description={description} ogImage="/images/تخريم-خرسانة-بالكور.webp">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content animate-up">
      <div class="hero-badge">متخصصون في تخريم الخرسانة منذ أكثر من 8 سنوات</div>
      <h1 id="hero-heading">تخريم وقص<br />الخرسانة المسلحة</h1>
      <p>صنايعي كور — متخصصون في عمل فتحات الكور دريل وقص الخرسانة بالمنشار الماسي بدقة هندسية وبدون اهتزازات في جميع محافظات مصر.</p>
      <div class="hero-btns">
        <a href="tel:+201055550195" class="btn btn-white btn-lg" id="hero-call">اتصل الآن — 01055550195</a>
        <a href="https://wa.me/201055550195" class="btn btn-ghost" target="_blank" rel="noopener noreferrer" id="hero-wa">تواصل واتساب</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><strong>+500</strong><span>مشروع منفذ</span></div>
        <div class="hero-stat"><strong>+8</strong><span>سنوات خبرة</span></div>
        <div class="hero-stat"><strong>24</strong><span>ساعة خدمة</span></div>
        <div class="hero-stat"><strong>100%</strong><span>ضمان الجودة</span></div>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar" role="complementary" aria-label="مميزاتنا">
    <div class="container">
      <div class="trust-item"><span class="trust-dot"></span><span>بدون اهتزازات أو تشقيق</span></div>
      <div class="trust-item"><span class="trust-dot"></span><span>دقة هندسية بالمليمتر</span></div>
      <div class="trust-item"><span class="trust-dot"></span><span>تنفيذ في نفس اليوم</span></div>
      <div class="trust-item"><span class="trust-dot"></span><span>معاينة مجانية</span></div>
      <div class="trust-item"><span class="trust-dot"></span><span>جميع محافظات مصر</span></div>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section" id="services" aria-labelledby="services-h">
    <div class="container">
      <div class="section-header">
        <div class="section-label">خدماتنا</div>
        <h2 id="services-h">خدمات <span>قص وتخريم الخرسانة</span> المتكاملة</h2>
        <p>أحدث تقنيات تخريم الخرسانة المسلحة بمعدات ألمانية متخصصة وفريق هندسي محترف</p>
      </div>

      <!-- Big cards -->
      <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:20px">
        <a href="/تخريم-خرسانة/" class="service-photo-card" id="srv-core">
          <div class="service-no-img"><span>CORE</span></div>
          <div class="service-photo-overlay">
            <h3>تخريم خرسانة بالكور دريل</h3>
            <p>عمل فتحات دائرية دقيقة في الخرسانة المسلحة بتقنية Diamond Core Drilling. مثالية للغاز والسباكة والتكييف والكهرباء بأقطار من 1 إلى 12 بوصة.</p>
            <span class="service-link-btn">اعرف أكثر &#x2190;</span>
          </div>
        </a>

        <div class="grid-2">
          <a href="/قص-خرسانة/" class="service-photo-card" id="srv-saw">
            <div class="service-no-img"><span>SAW</span></div>
            <div class="service-photo-overlay">
              <h3>قص خرسانة بالمنشار الماسي</h3>
              <p>قص مستقيم بدقة ليزر لفتح الأبواب والنوافذ والممرات في الجدران الخرسانية بدون اهتزاز.</p>
              <span class="service-link-btn">اعرف أكثر &#x2190;</span>
            </div>
          </a>
          <a href="/خدماتنا/فتحات-غاز/" class="service-photo-card" id="srv-gas">
            <div class="service-no-img"><span>GAS</span></div>
            <div class="service-photo-overlay">
              <h3>فتحات كور الغاز الطبيعي</h3>
              <p>فتحات الغاز الطبيعي والسخانات بالقطر المعتمد (2 بوصة) من شركة الغاز المصرية.</p>
              <span class="service-link-btn">اعرف أكثر &#x2190;</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Small icon cards -->
      <div class="grid-3">
        <a href="/خدماتنا/فتحات-تكييف/" class="service-icon-card" id="srv-ac">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24"><path d="M8 6h8M8 12h8M8 18h8M4 6h.01M4 12h.01M4 18h.01"/></svg>
          </div>
          <h3>فتحات تكييف وتهوية</h3>
          <p>فتحات التكييف السبليت والمركزي وشفاطات الحمام والمطبخ بأقطار متعددة.</p>
        </a>
        <a href="/خدماتنا/فتحات-سباكة/" class="service-icon-card" id="srv-plumb">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24"><path d="M12 2v6m0 8v6M4.93 4.93l4.24 4.24m5.66 5.66 4.24 4.24M2 12h6m8 0h6M4.93 19.07l4.24-4.24m5.66-5.66 4.24-4.24"/></svg>
          </div>
          <h3>فتحات سباكة وصرف صحي</h3>
          <p>تمديدات مياه الصرف والسباكة في الجدران والأرضيات الخرسانية بدقة عالية.</p>
        </a>
        <a href="/خدماتنا/" class="service-icon-card" id="srv-elec">
          <div class="service-card-icon">
            <svg viewBox="0 0 24 24"><polyline points="13 2 13 9 22 9"/><path d="M11 22 2 12l11-1"/></svg>
          </div>
          <h3>فتحات تمديدات كهربائية</h3>
          <p>ثقوب كوندويت الكهرباء وكابلات الشبكات وكاميرات المراقبة بأمان تام.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section-alt" id="how" aria-labelledby="steps-h">
    <div class="container">
      <div class="section-header">
        <div class="section-label">آلية عملنا</div>
        <h2 id="steps-h">كيف ننفذ مشروعك في <span>4 خطوات</span>؟</h2>
        <p>عملية تخريم الخرسانة عندنا سلسة وسريعة وبدون أي إزعاج</p>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>تواصل معنا</h3>
          <p>اتصل أو أرسل صورة عبر واتساب وسنرد فوراً بعرض سعر مبدئي</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>معاينة مجانية</h3>
          <p>يصل فريقنا للمعاينة وتحديد أفضل طريقة تنفيذ واختيار المعدة المناسبة</p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>التنفيذ الاحترافي</h3>
          <p>ننفذ العمل بدقة هندسية باستخدام معدات ألمانية Hilti بدون غبار أو ضوضاء</p>
        </div>
        <div class="step-card">
          <div class="step-num">4</div>
          <h3>تسليم نظيف بضمان</h3>
          <p>نسلم الموقع نظيفاً تماماً مع ضمان جودة كامل على الأعمال المنفذة</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section" id="why" aria-labelledby="why-h">
    <div class="container">
      <div class="split-section">
        <div class="split-img-wrap">
          <div class="img-placeholder"><span>CORE</span></div>
          <div class="float-card">
            <strong>+500</strong>
            <span>مشروع منجز</span>
          </div>
        </div>
        <div>
          <div class="side-label">لماذا صنايعي كور</div>
          <h2 id="why-h">لماذا نعتبر <span style="color:var(--primary)">الخيار الأول</span> لتخريم الخرسانة في مصر؟</h2>
          <p style="color:var(--text-muted);margin:14px 0 0;">نحن لسنا مجرد صنايعي عادي — متخصصون في الحلول الهندسية الصعبة بأحدث المعدات الألمانية وأكثر من 8 سنوات خبرة في السوق المصري.</p>
          <div class="features-list">
            <div class="feature-item">
              <div class="feature-icon-box">
                <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              </div>
              <div class="feature-text">
                <h4>معدات ألمانية Hilti &amp; Tyrolit</h4>
                <p>نستخدم حصرياً معدات كور دريل ألمانية لضمان دقة تصل إلى 0.5 مم</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon-box">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              </div>
              <div class="feature-text">
                <h4>دقة هندسية بالمليمتر</h4>
                <p>تقنية Diamond Core Bit تضمن فتحات مستديرة تماماً بأي قطر من 1 إلى 12 بوصة</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon-box">
                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              </div>
              <div class="feature-text">
                <h4>بدون ضوضاء أو غبار</h4>
                <p>الحفر الرطب يلغي الغبار ويقلل الضوضاء إلى الحد الأدنى</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon-box">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="feature-text">
                <h4>تنفيذ في نفس اليوم</h4>
                <p>معظم أعمال التخريم تنتهي خلال ساعات مع تسليم الموقع فوراً</p>
              </div>
            </div>
          </div>
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="why-cta">احجز معاينة مجانية — 01055550195</a>
        </div>
      </div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="section-alt" id="areas" aria-labelledby="areas-h">
    <div class="container">
      <div class="section-header">
        <div class="section-label">مناطق الخدمة</div>
        <h2 id="areas-h">نخدم جميع <span>محافظات مصر</span></h2>
        <p>فريق صنايعي كور يصل إليك أينما كنت في أسرع وقت ممكن</p>
      </div>
      <div class="areas-grid">
        <a href="/مناطق/القاهرة/" class="area-card" id="area-cairo">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <h3>القاهرة الكبرى</h3>
          <p>مصر الجديدة، التجمع، المعادي</p>
        </a>
        <a href="/مناطق/الجيزة/" class="area-card" id="area-giza">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><polygon points="12 2 22 22 2 22"/></svg>
          </div>
          <h3>الجيزة</h3>
          <p>الدقي، المهندسين، فيصل، الهرم</p>
        </a>
        <a href="/مناطق/أكتوبر/" class="area-card" id="area-oct">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>
          </div>
          <h3>6 أكتوبر والشيخ زايد</h3>
          <p>حدائق أكتوبر، القرية الذكية</p>
        </a>
        <a href="/مناطق/الإسكندرية/" class="area-card" id="area-alex">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><circle cx="12" cy="11" r="3"/></svg>
          </div>
          <h3>الإسكندرية</h3>
          <p>سيدي بشر، المنتزه، سموحة</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-delta">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3"/></svg>
          </div>
          <h3>الدلتا والقناة</h3>
          <p>المنصورة، طنطا، الإسماعيلية</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-upper">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </div>
          <h3>الصعيد</h3>
          <p>أسيوط، سوهاج، قنا، الأقصر</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-new">
          <div class="area-icon-box">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </div>
          <h3>المدن الجديدة</h3>
          <p>العاصمة الإدارية، العبور، بدر</p>
        </a>
        <a href="/اتصل-بنا/" class="area-card" id="area-other" style="border-color:var(--primary);background:rgba(29,63,143,.04)">
          <div class="area-icon-box" style="background:rgba(29,63,143,.12)">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.06 2.18 2 2 0 012 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 14.92v2z"/></svg>
          </div>
          <h3>محافظتك غير مذكورة؟</h3>
          <p>اتصل بنا وسنصلك أينما كنت</p>
        </a>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section" id="reviews" aria-labelledby="reviews-h">
    <div class="container">
      <div class="section-header">
        <div class="section-label">آراء العملاء</div>
        <h2 id="reviews-h">ماذا يقول <span>عملاؤنا</span> عنا؟</h2>
      </div>
      <div class="testimonials-grid">
        <article class="testimonial-card">
          <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">عملت فتحات كور للغاز الطبيعي في شقتي الجديدة، الشغل كان نظيف جداً وبدون أي غبار. الصنايعي محترف ومنظم وسلم الأوضة نظيفة.</p>
          <div class="testimonial-author">
            <div class="author-avatar">أ</div>
            <div class="author-info"><strong>أحمد المنصوري</strong><span>مهندس — القاهرة</span></div>
          </div>
        </article>
        <article class="testimonial-card">
          <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">كنت محتاج فتحة كور في الحمام لتركيب شفاط، الشغل اتعمل في أقل من ساعة بدقة ممتازة. السعر معقول والتواصل سريع جداً.</p>
          <div class="testimonial-author">
            <div class="author-avatar">م</div>
            <div class="author-info"><strong>محمد سالم</strong><span>صاحب شقة — الجيزة</span></div>
          </div>
        </article>
        <article class="testimonial-card">
          <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="testimonial-text">فريق محترف ومتخصص. عملوا لنا فتحات تكييف في مكتبنا وكان الشغل احترافي جداً. ننصح بهم لأي مشروع تخريم خرسانة.</p>
          <div class="testimonial-author">
            <div class="author-avatar">ه</div>
            <div class="author-info"><strong>هنا عبدالله</strong><span>صاحبة شركة — 6 أكتوبر</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section-alt" id="pricing" aria-labelledby="pricing-h">
    <div class="container">
      <div class="section-header">
        <div class="section-label">الأسعار التقريبية</div>
        <h2 id="pricing-h">أسعار <span>تخريم وقص الخرسانة</span></h2>
        <p>أسعار تنافسية وشفافة — احصل على عرض سعر دقيق مجاناً</p>
      </div>
      <div style="overflow:hidden;border-radius:var(--radius);border:1px solid var(--border)">
        <table class="pricing-table" role="table" aria-label="أسعار خدمات تخريم الخرسانة" style="border:none;border-radius:0">
          <thead>
            <tr>
              <th>الخدمة</th>
              <th>القطر / المقاس</th>
              <th>السعر التقريبي</th>
              <th>ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>فتحة كور غاز طبيعي</td><td>2 بوصة (5 سم)</td><td>150 – 250 ج</td><td>القطر المعتمد</td></tr>
            <tr><td>فتحة كور سباكة</td><td>3-4 بوصة</td><td>200 – 350 ج</td><td>حسب السُمك والتسليح</td></tr>
            <tr><td>فتحة كور تكييف</td><td>3-4 بوصة</td><td>250 – 400 ج</td><td>حسب وحدة التكييف</td></tr>
            <tr><td>فتحة كور شفاط</td><td>4-6 بوصة</td><td>200 – 350 ج</td><td>يُحدد بعد المعاينة</td></tr>
            <tr><td>قص جدار (باب)</td><td>90 × 210 سم</td><td>600 – 1500 ج</td><td>حسب سُمك الجدار</td></tr>
            <tr><td>قص جدار (شباك)</td><td>100 × 120 سم</td><td>400 – 900 ج</td><td>حسب سُمك الجدار</td></tr>
          </tbody>
        </table>
      </div>
      <p class="pricing-note">الأسعار تقريبية وتختلف حسب السُمك والتسليح والمنطقة. للسعر الدقيق اتصل بنا.</p>
      <div class="text-center mt-32">
        <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="pricing-cta">احصل على عرض سعر مجاني — 01055550195</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq" aria-labelledby="faq-h">
    <div class="container">
      <div class="faq-layout">
        <div>
          <div class="side-label">الأسئلة الشائعة</div>
          <h2 id="faq-h">كل ما تريد معرفته عن <span style="color:var(--primary)">تخريم الخرسانة</span></h2>
          <p style="color:var(--text-muted);margin:14px 0 26px;">إجابات واضحة ومفصلة على الأسئلة الأكثر شيوعاً</p>
          <div class="faq-list">
            <div class="faq-item open">
