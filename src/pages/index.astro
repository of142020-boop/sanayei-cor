---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from '../components/QuoteRequest.astro';
const services = [
  { n: '01', title: 'تخريم خرسانة بالكور دريل', href: 'تخريم-خرسانة', text: 'فتحات دائرية لمرور المواسير والكابلات في الحوائط والأسقف الخرسانية، بالمقاس المناسب للتنفيذ.' },
  { n: '02', title: 'فتحات التكييف والتهوية', href: 'فتحات-تكييف', text: 'فتحات مسارات مواسير التكييف والتهوية، مع تحديد المسار والميل المطلوب مع فني التركيب.' },
  { n: '03', title: 'فتحات الغاز والشفاطات', href: 'فتحات-الغاز-والشفاطات', text: 'تخريم لتمديدات الغاز ومداخن السخانات والشفاطات طبقًا للمقاس والموقع المطلوبين من جهة التركيب.' },
  { n: '04', title: 'فتحات السباكة والصرف', href: 'فتحات-سباكة', text: 'فتحات عبور مواسير المياه والصرف؛ يتحدد القطر بناءً على الماسورة والعزل والخلوص المطلوب.' },
  { n: '05', title: 'قص الخرسانة بالمنشار', href: 'قص-الخرسانة-بالمنشار', text: 'قص مستقيم لفتحات الأبواب والنوافذ وأعمال التعديل، بعد مراجعة واعتماد الجزء المطلوب قصه.' },
  { n: '06', title: 'تزريع أشاير الحديد', href: 'تزريع-اشاير-حديد', text: 'تجهيز ثقوب التثبيت والتزريع وفق مواصفات المادة المستخدمة والتصميم المعتمد للمشروع.' },
];
const areas = [ ['القاهرة', 'مدينة نصر، مصر الجديدة، المعادي وحلوان'], ['الجيزة', 'الهرم، فيصل، الدقي والمهندسين'], ['التجمع-الخامس', 'التجمع الخامس والقاهرة الجديدة'], ['اكتوبر-وزايد', '6 أكتوبر والشيخ زايد'], ['الإسكندرية', 'تواصل لتأكيد التغطية والموعد'] ];
const faqs = [
  ['ما الفرق بين الكور والتخريم بالشاكوش؟', 'الكور دريل يستخدم رأسًا أسطوانيًا ماسيًا لإخراج فتحة دائرية، بينما يعتمد الشاكوش على الطرق والتكسير. اختيار المعدة يتوقف على الخامة والمقاس وموقع العمل.'],
  ['كم سعر فتحة الكور؟', 'يتحدد السعر حسب قطر الفتحة وعمقها ونوع الخامة وعدد الفتحات ومكان الموقع وسهولة الوصول إليه. أرسل صورًا والمقاسات المطلوبة للحصول على تقدير، ويُؤكد السعر بعد مراجعة التفاصيل.'],
  ['هل يمكن تخريم سقف أو كمرة خرسانية؟', 'أي فتحة في عنصر إنشائي تحتاج مراجعة مهندس إنشائي واعتماد مكانها قبل التنفيذ. لا يكفي استخدام الكور وحده لضمان سلامة العنصر أو السماح بقطع حديد التسليح.'],
  ['ما مقاس فتحة الغاز أو التكييف؟', 'لا يوجد مقاس واحد يصلح لكل الحالات. يُحدد القطر والمكان حسب مواصفات الجهاز والماسورة ومتطلبات شركة الغاز أو فني التكييف قبل بدء التخريم.'],
  ['هل أحتاج تجهيز المكان قبل وصول صنايعي الكور؟', 'أرسل صور الجهتين إن أمكن، وحدد عدد الفتحات ومقاساتها وارتفاعها. أبعد الأثاث عن موضع العمل واتفق على مصدر الكهرباء والمياه وطريقة تجميع مخلفات الحفر.'],
];
---
<Layout title="صنايعي كور | تخريم خرسانة بالكور دريل — اتصل 01271940742" description="صنايعي كور لخدمات تخريم الخرسانة بالكور دريل وفتحات التكييف والغاز والسباكة وقص الخرسانة. اتصل على 01271940742 أو أرسل صور الموقع والمقاسات لطلب عرض سعر واضح.">
  <section class="core-hero" aria-labelledby="hero-heading">
    <div class="container core-hero-grid">
      <div>
        <span class="eyebrow">فتحات مدروسة. تنفيذ على المقاس.</span>
        <h1 id="hero-heading">صنايعي كور<br /><span>لخدمات الكور<br />وتخريم الخرسانة — 01271940742</span></h1>
        <p class="hero-lead">من فتحة تكييف في شقتك إلى تمديدات مشروعك. تخريم بالكور دريل للغاز والسباكة والتهوية، وقص الخرسانة بالمنشار في القاهرة والجيزة والمناطق الموضحة بالموقع.</p>
        <div class="core-actions">
          <a href="tel:+201271940742" class="btn btn-gold">اتصل بصنايعي كور <bdi>01271940742</bdi></a>
          <a href="#quote" class="btn btn-ghost">اطلب عرض سعر ←</a>
        </div>
        <div class="hero-specs"><span>فتحات حوائط وأسقف</span><span>غاز · تكييف · سباكة</span><span>تحديد المقاس قبل التنفيذ</span></div>
      </div>
      <div class="technical-panel">
        <div class="panel-top"><span>SANAYEI CORE</span><span>SC / 01</span></div>
        <div class="brand-showcase">
          <div class="brand-showcase-glow" aria-hidden="true"></div>
          <img src="/images/sanayei-cor-logo.png" width="512" height="512" alt="شعار صنايعي كور: ماكينة كور ومنشار لقص الخرسانة" fetchpriority="high" />
        </div>
        <div class="panel-caption"><strong>كور دريل ومنشار خرسانة</strong><p>معدات متخصصة لفتحات الكور والقص الماسي.<br />أرسل تفاصيل موقعك لنساعدك تحدد الخدمة المناسبة.</p></div>
        <a href="/خدماتنا/تخريم-خرسانة/" class="panel-link">تعرّف على خدمة تخريم الخرسانة ←</a>
      </div>
    </div>
  </section>
  <div class="brief-strip"><div class="container"><strong>محتاج فتحة كور؟</strong><span>أرسل صورة + المنطقة + المقاس + عدد الفتحات</span><a href="#quote">جهّز طلبك في دقيقة ←</a></div></div>
  <section class="section" id="services" aria-labelledby="services-h">
    <div class="container">
      <div class="section-heading-row"><div><span class="section-label">الخدمة المناسبة لشغلك</span><h2 id="services-h">خدمات الكور والتخريم<br /><span class="text-primary">من أول فتحة لحد تسليم الشغل</span></h2></div><a class="text-link" href="/خدماتنا/">كل الخدمات ←</a></div>
      <div class="grid-3">{services.map(service => <a class="core-service" href={`/خدماتنا/${service.href}/`}><span class="service-number">{service.n}</span><h3>{service.title}</h3><p>{service.text}</p><span class="text-link">تفاصيل الخدمة ←</span></a>)}</div>
    </div>
  </section>
  <section class="section-alt" aria-labelledby="choose-h"><div class="container core-guide-grid">
    <div><span class="section-label">قبل ما تبدأ</span><h2 id="choose-h">اختيار صنايعي كور<br />يبدأ بفهم المطلوب</h2><p class="spaced-copy">لو بتدور على فني كور أو مقاول تخريم خرسانة، وضوح التفاصيل من البداية يساعدك تقارن عروض الأسعار وتجهّز الموقع صح.</p><a href="/خدماتنا/تخريم-خرسانة/" class="text-link">دليل خدمة تخريم الخرسانة ←</a></div>
    <div class="check-list"><div><b>01 / مقاس مناسب للتركيب</b><p>راجع قطر الماسورة والخلوص والميل مع فني التركيب، بدل توسيع الفتحة بعد التشطيب.</p></div><div><b>02 / مراجعة مكان الفتحة</b><p>تأكد من مسارات الكهرباء والمياه، واطلب اعتماد المهندس قبل العمل في العناصر الإنشائية.</p></div><div><b>03 / اتفاق واضح على التكلفة</b><p>وضّح العدد والعمق والخامة والارتفاع، وهل السعر يشمل الانتقال وتجميع مخلفات الحفر.</p></div></div>
  </div></section>
  <section class="section" aria-labelledby="quick-answers-h"><div class="container"><div class="section-header"><span class="section-label">إجابات واضحة قبل الاتصال</span><h2 id="quick-answers-h">أسئلة سريعة عن الكور وتخريم الخرسانة</h2><p>هذه الإجابات تساعدك تجهز طلبك؛ القرار النهائي يتحدد بعد مراجعة الموقع والتفاصيل.</p></div><dl class="quick-answers"><div><dt>ما الفرق بين الكور دريل والتكسير؟</dt><dd>الكور دريل يجهز فتحة دائرية بالمقاس المطلوب لمرور المواسير أو الكابلات، بينما التكسير يُستخدم لأعمال مختلفة وقد يؤثر على التشطيبات حول مكان الفتحة.</dd></div><div><dt>كيف أحدد مقاس فتحة التكييف أو الغاز؟</dt><dd>اطلب القطر والميل والمكان من فني التركيب أو جهة الغاز قبل الحفر؛ مقاس الماسورة وحده لا يكفي دائمًا بسبب العزل والخلوص.</dd></div><div><dt>ما المعلومات المطلوبة لعرض سعر دقيق؟</dt><dd>أرسل المنطقة وصور المكان وعدد الفتحات والقطر وسُمك الحائط أو السقف إن أمكن، ثم نراجع الوصول والخامة قبل تأكيد السعر والموعد.</dd></div></dl><div class="core-actions"><a class="btn btn-primary" href="/خدماتنا/تخريم-خرسانة/">تفاصيل تخريم الخرسانة</a><a class="btn btn-outline" href="/الاسئلة-الشائعة/">كل الأسئلة الشائعة</a></div></div></section>
  <section class="section" aria-labelledby="process-h"><div class="container"><div class="section-header"><span class="section-label">من الطلب للتنفيذ</span><h2 id="process-h">شغلك واضح في كل خطوة</h2></div><div class="steps-grid">
    {[['أرسل التفاصيل','صورة المكان، المنطقة، عدد الفتحات والمقاسات المطلوبة.'],['راجع عرض السعر','نراجع الخامة والعمق وإمكانية الوصول ونوضح التفاصيل المطلوبة للتسعير.'],['اتفق على الموعد','نؤكد إمكانية الخدمة في منطقتك والتجهيزات قبل الزيارة.'],['تنفيذ ومراجعة','يُنفذ العمل في الموقع والمقاس المتفق عليهما، مع مراجعة الفتحات عند التسليم.']].map(([heading, text], index) => <div class="step-card"><span class="step-num">{index + 1}</span><h3>{heading}</h3><p>{text}</p></div>)}
  </div></div></section>
  <section class="section" aria-labelledby="guides-h"><div class="container"><div class="section-heading-row"><div><span class="section-label">قرر وأنت فاهم التفاصيل</span><h2 id="guides-h">أدلة عملية قبل طلب الكور</h2></div><a href="/نبذة-عنا/" class="text-link">عن صنايعي كور ←</a></div><div class="grid-3"><a class="core-service" href="/مقالات/core-drilling-uses/"><h3>ما المقاس المناسب لفتحتك؟</h3><p class="spaced-copy">ما الذي تطلبه من فني الغاز أو التكييف أو السباكة قبل تحديد القطر والمكان.</p><span class="text-link">دليل استخدامات الكور ←</span></a><a class="core-service" href="/مقالات/concrete-cutting-types/"><h3>كور أم منشار ماسي؟</h3><p class="spaced-copy">اختيار الخدمة حسب شكل الفتحة والغرض منها وتفاصيل موضع العمل.</p><span class="text-link">قارن طرق الفتح والقص ←</span></a><a class="core-service" href="/مقالات/concrete-cutting-prices/"><h3>كيف تقارن عروض الأسعار؟</h3><p class="spaced-copy">راجع وحدة التسعير والأبعاد والبنود المشمولة والرفع والترحيل قبل الاتفاق.</p><span class="text-link">دليل مقارنة التكلفة ←</span></a></div></div></section>
  <section class="section-alt" id="quote" aria-labelledby="quote-h"><div class="container core-guide-grid"><div><span class="section-label">اعرف تكلفة شغلك</span><h2 id="quote-h">سعر فتحة الكور<br />حسب تفاصيل موقعك</h2><p class="spaced-copy">القطر والسُمك ونوع الخرسانة وعدد الفتحات عوامل أساسية في تكلفة التخريم. جهّز الطلب هنا وافتحه على واتساب، وأرفق صور الموقع داخل المحادثة.</p><a href="/اسعار-الخدمات/" class="text-link">تفاصيل عوامل تسعير الخدمات ←</a><p class="quote-note">هذا طلب عرض سعر؛ الموعد والتكلفة يتأكدان بعد مراجعة التفاصيل معك.</p></div><QuoteRequest /></div></section>
  <section class="section" aria-labelledby="areas-h"><div class="container"><div class="section-heading-row"><div><span class="section-label">نطاق الخدمة</span><h2 id="areas-h">صنايعي كور قريب من شغلك</h2></div><a href="/مناطق/" class="text-link">تفاصيل مناطق الخدمة ←</a></div><div class="area-links">{areas.map(([slug, text]) => <a href={`/مناطق/${slug}/`}><h3>{slug.replaceAll('-', ' ')}</h3><p>{text}</p><span aria-hidden="true">←</span></a>)}</div><p class="quote-note">تواصل لتأكيد إمكانية الوصول إلى عنوانك وموعد التنفيذ قبل الحجز.</p></div></section>
  <section class="section-alt" aria-labelledby="faq-h"><div class="container core-guide-grid"><div><span class="section-label">إجابات تهمك</span><h2 id="faq-h">أسئلة عن الكور<br />وتخريم الخرسانة</h2><p class="spaced-copy">من المقاس والتكلفة إلى تجهيز الموقع.</p><a href="/الاسئلة-الشائعة/" class="text-link">المزيد من الأسئلة ←</a></div><div class="native-faq">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
  <section class="cta-section"><div class="container cta-inner"><span class="eyebrow">ابدأ بتفاصيل شغلك</span><h2>محتاج صنايعي كور؟<br />خلّينا نراجع المطلوب معاك</h2><p>اتصل مباشرة أو أرسل صورة المكان على واتساب لطلب عرض سعر.</p><div class="cta-btns"><a href="tel:+201271940742" class="btn btn-white"><bdi>01271940742</bdi> — اتصال مباشر</a><a href="https://wa.me/201271940742?text=أريد%20عرض%20سعر%20لأعمال%20الكور%20والتخريم" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">أرسل تفاصيلك على واتساب</a></div></div></section>
</Layout>
