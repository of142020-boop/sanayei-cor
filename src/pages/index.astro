---
import Layout from '../layouts/Layout.astro';

const title = "صنايعي كور | تخريم وقص الخرسانة المسلحة في مصر | 01055550195";
const description = "صنايعي كور متخصص في تخريم الخرسانة بالكور دريل وقص الخرسانة المسلحة بالمنشار الماسي. فتحات غاز وتكييف وسباكة. أسرع وأدق صنايعي كور في مصر — اتصل الآن 01055550195";
const ogImage = "/images/تخريم-خرسانة-بالكور.webp";
---

<Layout title={title} description={description} ogImage={ogImage}>

  <!-- ===== HERO: Full image + dark overlay ===== -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content animate-fadeInUp">
      <div class="badge"> متخصصون منذ أكثر من 8 سنوات</div>
      <h1 id="hero-heading">
        تخريم وقص<br />الخرسانة المسلحة
      </h1>
      <p>
        <strong>صنايعي كور</strong> — متخصصون في عمل فتحات الكور دريل وقص الخرسانة بالمنشار الماسي.
        دقة هندسية، بدون اهتزازات، في جميع محافظات مصر.
      </p>
      <div class="hero-btns">
        <a href="tel:+201055550195" class="btn btn-white btn-lg" id="hero-cta-call">
           اتصل الآن — 01055550195
        </a>
        <a href="https://wa.me/201055550195?text=مرحباً، أريد الاستفسار عن خدمات الكور" class="btn btn-outline" style="border-color:rgba(255,255,255,0.6); color:white;" target="_blank" rel="noopener noreferrer" id="hero-cta-whatsapp">
           واتساب
        </a>
      </div>
      <div class="hero-stats-bar">
        <div class="hero-stat-item">
          <span class="hero-stat-number">+500</span>
          <span class="hero-stat-label">مشروع منفذ</span>
        </div>
        <div class="hero-stat-item">
          <span class="hero-stat-number">+8</span>
          <span class="hero-stat-label">سنوات خبرة</span>
        </div>
        <div class="hero-stat-item">
          <span class="hero-stat-number">24</span>
          <span class="hero-stat-label">ساعة خدمة</span>
        </div>
        <div class="hero-stat-item">
          <span class="hero-stat-number">100%</span>
          <span class="hero-stat-label">ضمان الجودة</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TRUST BAR ===== -->
  <section class="trust-bar" aria-label="مزايا خدمتنا">
    <div class="container">
      <div class="trust-items">
        <div class="trust-item"><span class="icon"></span><span>بدون اهتزازات أو تشقيق</span></div>
        <div class="trust-item"><span class="icon"></span><span>دقة بالمليمتر</span></div>
        <div class="trust-item"><span class="icon"></span><span>تنفيذ سريع في نفس اليوم</span></div>
        <div class="trust-item"><span class="icon"></span><span>معاينة مجانية</span></div>
        <div class="trust-item"><span class="icon"></span><span>خدمة لجميع المحافظات</span></div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES: Photo Cards (CSMisr style) ===== -->
  <section class="section" id="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">خدماتنا</span>
        <h2 id="services-heading">باقة متكاملة من خدمات <span>قص وتخريم الخرسانة</span></h2>
        <p>نقدم أحدث تقنيات قص وتخريم الخرسانة المسلحة بمعدات ألمانية متخصصة وفريق هندسي محترف</p>
      </div>

      <!-- Big photo cards like CSMisr -->
      <div style="display:flex; flex-direction:column; gap:20px; margin-bottom:20px;">
        <a href="/تخريم-خرسانة/" class="service-photo-card" id="service-core-drill" style="display:block;">
          <img src="/images/تخريم-خرسانة-بالكور.webp" alt="تخريم خرسانة بالكور دريل — عمل فتحات دائرية دقيقة في الخرسانة المسلحة" width="1200" height="280" loading="lazy" />
          <div class="service-photo-overlay">
            <h3>تخريم خرسانة بالكور دريل</h3>
            <p>عمل فتحات دائرية دقيقة في الخرسانة المسلحة بتقنية Diamond Core Drilling. مثالية للغاز والسباكة والتكييف والكهرباء.</p>
            <span class="service-photo-link">اعرف أكثر ←</span>
          </div>
        </a>

        <div class="grid-2" style="gap:20px;">
          <a href="/قص-خرسانة/" class="service-photo-card" id="service-saw-cut" style="display:block;">
            <img src="/images/منشار-قص-الخرسانة.webp" alt="قص خرسانة بالمنشار الماسي — فتح أبواب ونوافذ في الجدران الخرسانية" width="600" height="320" loading="lazy" />
            <div class="service-photo-overlay">
              <h3>قص خرسانة بالمنشار الماسي</h3>
              <p>قص مستقيم بدقة ليزر لفتح الأبواب والنوافذ والممرات بدون اهتزاز.</p>
              <span class="service-photo-link">اعرف أكثر ←</span>
            </div>
          </a>

          <a href="/خدماتنا/فتحات-غاز/" class="service-photo-card" id="service-gas" style="display:block;">
            <img src="/images/فتحات-كور-للجدران.webp" alt="فتحات كور الغاز الطبيعي — القطر المعتمد 2 بوصة" width="600" height="320" loading="lazy" />
            <div class="service-photo-overlay">
              <h3>فتحات كور الغاز الطبيعي</h3>
              <p>فتحات الغاز الطبيعي والسخانات بالقطر المعتمد من شركة الغاز المصرية.</p>
              <span class="service-photo-link">اعرف أكثر ←</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Small icon cards for remaining services -->
      <div class="grid-3">
        <a href="/خدماتنا/فتحات-تكييف/" class="service-icon-card" id="service-ac">
          <div class="service-icon"></div>
          <h3>فتحات تكييف وتهوية</h3>
          <p>فتحات وحدات التكييف السبليت والمركزي وشفاطات الحمام والمطبخ بأقطار متعددة.</p>
        </a>
        <a href="/خدماتنا/فتحات-سباكة/" class="service-icon-card" id="service-plumbing">
          <div class="service-icon"></div>
          <h3>فتحات سباكة وصرف صحي</h3>
          <p>تمديدات مياه الصرف والسباكة في الجدران والأرضيات الخرسانية بدقة عالية.</p>
        </a>
        <a href="/خدماتنا/" class="service-icon-card" id="service-electric">
          <div class="service-icon"></div>
          <h3>فتحات تمديدات كهربائية</h3>
          <p>ثقوب كوندويت الكهرباء وكابلات الشبكات وكاميرات المراقبة بأمان تام.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="section-alt" id="how-it-works" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">آلية عملنا</span>
        <h2 id="steps-heading">كيف نُنجز مشروعك في <span>4 خطوات</span>؟</h2>
        <p>عملية تخريم الخرسانة عندنا سلسة، سريعة، وبدون أي إزعاج</p>
      </div>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-number">1</div>
          <h3>اتصل أو تواصل واتساب</h3>
          <p>صف لنا ما تحتاجه وأرسل صورة للمكان، وسنرد فوراً بعرض سعر مبدئي</p>
        </div>
        <div class="step-card">
          <div class="step-number">2</div>
          <h3>معاينة مجانية في الموقع</h3>
          <p>يصل فريقنا للمعاينة وتحديد أفضل طريقة تنفيذ واختيار المعدة المناسبة</p>
        </div>
        <div class="step-card">
          <div class="step-number">3</div>
          <h3>التنفيذ الاحترافي</h3>
          <p>ننفذ العمل بدقة هندسية عالية باستخدام معدات ألمانية Hilti وبدون غبار</p>
        </div>
        <div class="step-card">
          <div class="step-number">4</div>
          <h3>تسليم نظيف وضمان</h3>
          <p>نسلم الموقع نظيفاً تماماً مع ضمان جودة الأعمال المنفذة</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHY US - Split layout ===== -->
  <section class="section" id="why-us" aria-labelledby="why-heading">
    <div class="container">
      <div class="split-layout">
        <div class="split-image">
          <img src="/images/ماكينة-كور-دريل-الماني.webp" alt="ماكينة كور دريل ألمانية Hilti لتخريم الخرسانة المسلحة بدقة عالية" width="550" height="480" loading="lazy" />
          <div class="float-badge">
            <span class="num">+500</span>
            <span class="txt">مشروع منجز بنجاح</span>
          </div>
        </div>
        <div>
          <span class="label" style="display:inline-flex; align-items:center; gap:8px; color:var(--primary); font-size:0.9rem; font-weight:700; letter-spacing:1px; margin-bottom:16px;">
            <span style="width:30px; height:2px; background:var(--primary); display:block;"></span>
            لماذا صنايعي كور
            <span style="width:30px; height:2px; background:var(--primary); display:block;"></span>
          </span>
          <h2 id="why-heading">لماذا نعتبر <span>الخيار الأول</span> لتخريم الخرسانة في مصر؟</h2>
          <p style="color:var(--text-muted); margin:16px 0;">
            ليس مجرد صنايعي كور عادي — نحن متخصصون في الحلول الهندسية الصعبة بأحدث المعدات الألمانية وأكثر من 8 سنوات من الخبرة في السوق المصري.
          </p>
          <div class="features-list">
            <div class="feature-item">
              <div class="feature-icon">🇩🇪</div>
              <div class="feature-text">
                <h4>معدات ألمانية Hilti & Tyrolit</h4>
                <p>نستخدم حصرياً معدات الكور دريل الألمانية الأحدث لضمان دقة تصل إلى 0.5 مم</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <div class="feature-text">
                <h4>دقة هندسية بالمليمتر</h4>
                <p>تقنية Diamond Core Bit تضمن فتحات مستديرة تماماً بأي قطر مطلوب من 1 إلى 12 بوصة</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <div class="feature-text">
                <h4>بدون ضوضاء أو غبار مفرط</h4>
                <p>الحفر الرطب (Wet Drilling) يلغي الغبار تماماً ويقلل الضوضاء إلى الحد الأدنى</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon"></div>
              <div class="feature-text">
                <h4>تنفيذ في نفس اليوم</h4>
                <p>معظم أعمال التخريم تنتهي خلال ساعات مع تنظيف تام وتسليم الموقع فوراً</p>
              </div>
            </div>
          </div>
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="why-us-cta" style="margin-top:8px;">
             احجز صنايعي كور الآن
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== AREAS ===== -->
  <section class="section-alt" id="areas" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">مناطق الخدمة</span>
        <h2 id="areas-heading">نخدم جميع <span>محافظات مصر</span></h2>
        <p>فريق صنايعي كور يصل إليك أينما كنت في أسرع وقت ممكن</p>
      </div>
      <div class="areas-grid">
        <a href="/مناطق/القاهرة/" class="area-card" id="area-cairo">
          <div class="area-icon"></div>
          <h3>القاهرة الكبرى</h3>
          <p>مصر الجديدة، التجمع، المعادي، حلوان</p>
        </a>
        <a href="/مناطق/الجيزة/" class="area-card" id="area-giza">
          <div class="area-icon"></div>
          <h3>الجيزة</h3>
          <p>الدقي، المهندسين، فيصل، الهرم</p>
        </a>
        <a href="/مناطق/أكتوبر/" class="area-card" id="area-october">
          <div class="area-icon"></div>
          <h3>6 أكتوبر والشيخ زايد</h3>
          <p>حدائق أكتوبر، القرية الذكية</p>
        </a>
        <a href="/مناطق/الإسكندرية/" class="area-card" id="area-alex">
          <div class="area-icon"></div>
          <h3>الإسكندرية</h3>
          <p>سيدي بشر، المنتزه، سموحة</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-delta">
          <div class="area-icon"></div>
          <h3>الدلتا والقناة</h3>
          <p>المنصورة، طنطا، الإسماعيلية</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-upper">
          <div class="area-icon"></div>
          <h3>الصعيد</h3>
          <p>أسيوط، سوهاج، قنا، الأقصر</p>
        </a>
        <a href="/مناطق/" class="area-card" id="area-newcities">
          <div class="area-icon"></div>
          <h3>المدن الجديدة</h3>
          <p>العاصمة الإدارية، العبور، بدر</p>
        </a>
        <a href="/اتصل-بنا/" class="area-card" id="area-other" style="border-color:var(--primary); background:rgba(33,64,154,0.04);">
          <div class="area-icon"></div>
          <h3>محافظتك غير مذكورة؟</h3>
          <p>اتصل بنا وسنصلك أينما كنت</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIALS ===== -->
  <section class="section" id="testimonials" aria-labelledby="testimonials-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">آراء عملائنا</span>
        <h2 id="testimonials-heading">ماذا يقول <span>عملاؤنا</span> عنا؟</h2>
      </div>
      <div class="testimonials-grid">
        <article class="testimonial-card">
          <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">"عملت فتحات كور للغاز الطبيعي في شقتي الجديدة، الشغل كان نظيف جداً وبدون أي غبار. الصنايعي محترف ومنظم وسلم الأوضة نظيفة."</p>
          <div class="testimonial-author">
            <div class="author-avatar">أ</div>
            <div class="author-info">
              <strong>أحمد المنصوري</strong>
              <span>مهندس — القاهرة</span>
            </div>
          </div>
        </article>
        <article class="testimonial-card">
          <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">"كنت محتاج فتحة كور في الحمام لتركيب شفاط، الشغل اتعمل في أقل من ساعة بدقة ممتازة. السعر معقول والتواصل سريع جداً."</p>
          <div class="testimonial-author">
            <div class="author-avatar">م</div>
            <div class="author-info">
              <strong>محمد سالم</strong>
              <span>صاحب شقة — الجيزة</span>
            </div>
          </div>
        </article>
        <article class="testimonial-card">
          <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
          <p class="testimonial-text">"فريق محترف ومتخصص. عملوا لنا فتحات تكييف في مكتبنا وكان الشغل احترافي جداً. ما اضطررناش نشغل أي مقاول تاني بعد كده."</p>
          <div class="testimonial-author">
            <div class="author-avatar">ه</div>
            <div class="author-info">
              <strong>هنا عبدالله</strong>
              <span>صاحبة شركة — 6 أكتوبر</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===== PRICING TABLE ===== -->
  <section class="section-alt" id="pricing" aria-labelledby="pricing-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">الأسعار التقريبية</span>
        <h2 id="pricing-heading">أسعار <span>تخريم وقص الخرسانة</span></h2>
        <p>أسعار تنافسية وشفافة — احصل على عرض سعر دقيق مجاناً بالاتصال الآن</p>
      </div>
      <div class="card" style="overflow-x:auto; padding:0; border-radius:var(--radius-md); overflow:hidden;">
        <table class="pricing-table" role="table" aria-label="جدول أسعار خدمات تخريم الخرسانة" style="margin:0; border-radius:0;">
          <thead>
            <tr>
              <th scope="col">الخدمة</th>
              <th scope="col">القطر / المقاس</th>
              <th scope="col">السعر التقريبي (جنيه)</th>
              <th scope="col">ملاحظات</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>فتحة كور غاز طبيعي</td><td>2 بوصة (5 سم)</td><td>من 150 إلى 250 ج</td><td>القطر المعتمد من الشركة</td></tr>
            <tr><td>فتحة كور سباكة</td><td>3-4 بوصة</td><td>من 200 إلى 350 ج</td><td>حسب السُمك والتسليح</td></tr>
            <tr><td>فتحة كور تكييف</td><td>3-4 بوصة</td><td>من 250 إلى 400 ج</td><td>قطر حسب وحدة التكييف</td></tr>
            <tr><td>فتحة كور شفاط حمام</td><td>4-6 بوصة</td><td>من 200 إلى 350 ج</td><td>يُحدد بعد المعاينة</td></tr>
            <tr><td>قص جدار (فتح باب)</td><td>90×210 سم</td><td>من 600 إلى 1500 ج</td><td>حسب سُمك الجدار</td></tr>
            <tr><td>قص جدار (فتح شباك)</td><td>100×120 سم</td><td>من 400 إلى 900 ج</td><td>حسب سُمك الجدار</td></tr>
          </tbody>
        </table>
      </div>
      <p style="color:var(--text-muted); font-size:0.85rem; margin-top:12px; text-align:center;">* الأسعار تقريبية وتختلف حسب السُمك والتسليح والمنطقة. للسعر الدقيق اتصل بنا.</p>
      <div class="text-center mt-32">
        <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="pricing-cta"> احصل على عرض سعر مجاني — 01055550195</a>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="section" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <div class="faq-grid">
        <div>
          <span class="label" style="display:inline-flex; align-items:center; gap:8px; color:var(--primary); font-size:0.9rem; font-weight:700; letter-spacing:1px; margin-bottom:16px;">
            <span style="width:30px; height:2px; background:var(--primary); display:block;"></span>
            الأسئلة الشائعة
          </span>
          <h2 id="faq-heading">كل ما تريد معرفته عن <span>تخريم الخرسانة</span></h2>
          <p style="color:var(--text-muted); margin:16px 0 28px;">إجابات شاملة على أكثر الأسئلة شيوعاً</p>
          <div class="faq-list">
            <div class="faq-item open">
              <div class="faq-question" role="button" tabindex="0">
                <div class="q-icon">Q</div>
                <span>ما الفرق بين الكور دريل والمنشار في تخريم الخرسانة؟</span>
              </div>
              <div class="faq-answer">
                <p>الكور دريل يعمل فتحات دائرية للغاز والمياه والتكييف. أما المنشار الماسي فيقص بخط مستقيم لفتح الأبواب والنوافذ في الجدران.</p>
              </div>
            </div>
            <div class="faq-item">
              <div class="faq-question" role="button" tabindex="0">
                <div class="q-icon">Q</div>
                <span>هل تخريم الخرسانة بالكور يسبب تصدعات في المبنى؟</span>
              </div>
