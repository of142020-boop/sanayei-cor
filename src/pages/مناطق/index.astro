---
import Layout from '../../layouts/Layout.astro';
import { areas } from '../../data/areas';
---
<Layout title="مناطق خدمة صنايعي كور | القاهرة والجيزة والمناطق المحيطة" description="راجع صفحات مناطق خدمة صنايعي كور في القاهرة والجيزة والتجمع وأكتوبر وزايد والإسكندرية، وتواصل لتأكيد تغطية عنوانك وترتيبات الزيارة.">
<div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><span>المناطق</span></nav><h1>مناطق خدمة صنايعي كور</h1><p>اختَر المنطقة الأقرب لموقعك، وتواصل لتأكيد تغطية العنوان والموعد المتاح ومتطلبات الدخول قبل الحجز.</p></div></div>
<section class="section"><div class="container"><div class="grid-3">{areas.map(area => <a class="core-service" href={`/مناطق/${area.slug}/`}><h2 style="font-size:1.2rem">{area.name}</h2><p class="spaced-copy">{area.intro}</p><span class="text-link">تفاصيل الطلب في المنطقة ←</span></a>)}</div><p class="spaced-copy">إذا كان موقعك خارج هذه المناطق، أرسل العنوان التقريبي وحجم العمل للاستفسار عن إمكانية ترتيب زيارة. لا يُؤكد الموعد إلا بعد مراجعة التفاصيل.</p><a class="btn btn-primary" href="/اتصل-بنا/">استفسر عن تغطية موقعك</a></div></section>
</Layout>
