---
import Layout from "../../layouts/Layout.astro";

const title = "قص خرسانة بالمنشار الماسي | فتح أبواب ونوافذ في الجدران | 01055550195";
const description = "قص خرسانة مسلحة بالمنشار الماسي بدقة ليزر. فتح أبواب ونوافذ وممرات في الجدران الخرسانية بدون اهتزازات. مقاول قص خرسانة محترف — اتصل 01055550195";
---

<Layout title={title} description={description} ogImage="/images/منشار-قص-الخرسانة.webp" navbarStyle="solid">

  <div class="breadcrumb">
    <div class="container">
      <nav aria-label="مسار التنقل">
        <a href="/">الرئيسية</a>
        <span class="separator">›</span>
        <a href="/خدماتنا/">الخدمات</a>
        <span class="separator">›</span>
        <span>قص خرسانة</span>
      </nav>
      <h1>قص خرسانة بالمنشار الماسي</h1>
      <p>قص مستقيم وبدقة ليزر للجدران والأسقف الخرسانية لفتح الأبواب والنوافذ والممرات</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:60px; align-items:start;">
        <div>
          <h2>ما هو <strong style="color:var(--primary)">قص الخرسانة بالمنشار الماسي</strong>؟</h2>
          <p style="color:var(--text-muted); margin:16px 0;">قص الخرسانة بالمنشار الماسي (Diamond Track Saw / Wall Saw) هو تقنية قص مستقيمة تُستخدم لإحداث قطوعات رأسية وأفقية في الجدران والأسقف الخرسانية المسلحة. تنتج قطوعاً نظيفة وحادة وبدون أي تشققات جانبية.</p>

          <h2 style="margin-top:32px;">متى تحتاج إلى <strong style="color:var(--primary)">قص الخرسانة</strong>؟</h2>
          <div class="page-content">
            <ul>
              <li>فتح باب جديد في جدار خرساني مسلح</li>
              <li>فتح نافذة أو توسيع نافذة موجودة</li>
              <li>إنشاء ممر أو مدخل بين غرفتين</li>
              <li>تعديل مساحة المطبخ أو دورة المياه</li>
              <li>قص الأسقف لإضافة فتحة سلم داخلي</li>
              <li>هدم وإزالة جزء من الجدار الخرساني</li>
              <li>إنشاء فتحات تهوية كبيرة في الجدران</li>
            </ul>
          </div>

          <h2 style="margin-top:32px;">مزايا المنشار الماسي عن الطرق التقليدية</h2>
          <div class="features-list" style="margin-top:16px;">
            <div class="feature-item">
              <div class="feature-icon">🎯</div>
              <div class="feature-text">
                <h4>دقة ليزر — خط مستقيم تماماً</h4>
                <p>الرأس الماسي على سكة دقيقة يضمن خطاً مستقيماً بدون أي انحراف</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">🤫</div>
              <div class="feature-text">
                <h4>بدون اهتزاز أو تشقيق جانبي</h4>
                <p>خلافاً للدرفيل والمطرقة، المنشار الماسي لا يسبب أي تشققات في الخرسانة المحيطة</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">🔧</div>
              <div class="feature-text">
                <h4>يقص أي سُمك خرسانة</h4>
                <p>نستطيع قص جدران بسُمك من 10 سم حتى 60 سم ويزيد في مشاريع خاصة</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">⚡</div>
              <div class="feature-text">
                <h4>سرعة تنفيذ عالية</h4>
                <p>فتح باب كامل (90×210) في جدار 20 سم يستغرق من 2 إلى 4 ساعات فقط</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="card" style="margin-bottom:24px;">
            <h3 style="margin-bottom:20px; color:var(--primary);">📐 مقاسات الفتحات الشائعة</h3>
            <table class="pricing-table">
              <thead>
                <tr>
                  <th scope="col">نوع الفتحة</th>
                  <th scope="col">المقاس القياسي</th>
                  <th scope="col">السعر التقريبي</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>باب رئيسي</td><td>90 × 210 سم</td><td>600 - 1500 ج</td></tr>
                <tr><td>باب داخلي</td><td>80 × 200 سم</td><td>500 - 1200 ج</td></tr>
                <tr><td>نافذة كبيرة</td><td>150 × 120 سم</td><td>500 - 1100 ج</td></tr>
                <tr><td>نافذة عادية</td><td>100 × 100 سم</td><td>350 - 800 ج</td></tr>
                <tr><td>شباك صغير</td><td>60 × 80 سم</td><td>250 - 600 ج</td></tr>
                <tr><td>ممر / مدخل</td><td>حسب الطلب</td><td>يُقدّر بعد المعاينة</td></tr>
              </tbody>
            </table>
            <p style="color:var(--text-muted); font-size:0.8rem; margin-top:12px;">* تختلف الأسعار حسب سُمك الجدار ودرجة التسليح ومنطقة التنفيذ</p>
          </div>

          <div class="card">
            <h3 style="margin-bottom:16px;">📞 احجز الآن</h3>
            <p style="color:var(--text-muted); margin-bottom:20px; font-size:0.9rem;">اتصل بنا للمعاينة المجانية وعرض السعر الدقيق لمشروعك</p>
            <a href="tel:+201055550195" class="btn btn-primary w-full mb-16" id="saw-page-cta">📞 01055550195</a>
            <a href="https://wa.me/201055550195?text=أريد الاستفسار عن قص خرسانة" class="btn btn-outline w-full" target="_blank" rel="noopener noreferrer" id="saw-page-wa">💬 واتساب</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-section" aria-labelledby="saw-cta-heading">
    <div class="container">
      <div class="cta-inner">
        <h2 id="saw-cta-heading">هل تريد <span style="background:var(--grad-primary); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">فتح باب أو نافذة</span> في خرسانة؟</h2>
        <p>مقاول قص خرسانة محترف يصلك اليوم. معاينة مجانية وعرض سعر فوري.</p>
        <div class="cta-btns">
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="saw-final-call">📞 01055550195</a>
          <a href="/تخريم-خرسانة/" class="btn btn-outline btn-lg">← تخريم خرسانة بالكور</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
