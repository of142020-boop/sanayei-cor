---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/services';
---

<Layout
  title="خدمات تخريم وقص الخرسانة بالكور والمنشار في مصر | 01271940742"
  description="خدمات صنايعي كور في مصر: تخريم خرسانة بالكور دريل، قص الخرسانة بالمنشار الماسي، فتحات التكييف والغاز والسباكة، الشفاطات، وتزريع الأشاير. 01271940742."
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <span>الخدمات</span>
      </nav>
      <h1>خدمات تخريم وقص الخرسانة بالكور والمنشار — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">
        سبعة أقسام هندسية متخصصة لتغطية كافة احتياجات فتحات الكور والقص الماسي وتأسيس الشفاطات وتزريع أشاير الحديد في الشقق والفلل والمصانع والمشروعات.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        <a class="service-card" href="/خدماتنا/تخريم-خرسانة/">
          <span class="service-num">01</span>
          <h2>تخريم خرسانة وفتحات كور بالكور دريل</h2>
          <p>فتحات دائرية بأقطار 1 إلى 12 بوصة في الحوائط والأسقف الفلات سلاب لمرور المواسير والكابلات بدون تكسير أو اهتزازات.</p>
          <span class="text-link">تفاصيل التخريم بالكور ←</span>
        </a>
        {services.map((service, index) => (
          <a class="service-card" href={`/خدماتنا/${service.slug}/`}>
            <span class="service-num">{`0${index + 2}`}</span>
            <h2>{service.short}</h2>
            <p>{service.intro}</p>
            <span class="text-link">المواصفات والأسعار ←</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-surface">
    <div class="container">
      <div class="section-header">
        <span class="section-label">دليل اختيار الخدمة</span>
        <h2>أي خدمة ومعدة تناسب طبيعة شغلك؟</h2>
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th scope="col">العمل المطلوب بالموقع</th>
              <th scope="col">الخدمة والمعدة المناسبة</th>
              <th scope="col">المواصفات المطلوبة للتسعير</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>مرور ماسورة تكييف أو غاز أو صرف بفتحة دائرية</td>
              <td><a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تخريم الخرسانة بالكور دريل</a></td>
              <td>القطر بالبوصة، العدد، وسُمك الجدار أو السقف</td>
            </tr>
            <tr>
              <td>فتح باب أو شباك أو سلم في حائط أو سقف خرساني</td>
              <td><a class="text-link" href="/خدماتنا/قص-الخرسانة-بالمنشار/">قص الخرسانة بالمنشار الماسي</a></td>
              <td>الطول × العرض، سُمك الخرسانة، والاعتماد الإنشائي</td>
            </tr>
            <tr>
              <td>تركيب شفاط مطبخ أو حمام وتمديد الدكت والمدخنة</td>
              <td><a class="text-link" href="/خدماتنا/تركيب-وتأسيس-شفاطات/">تركيب وتأسيس الشفاطات</a></td>
              <td>نوع الشفاط وموديله، مسار الدكت، وخامة المخرج</td>
            </tr>
            <tr>
              <td>ربط كمرة أو سلم أو توسعة خرسانية جديدة</td>
              <td><a class="text-link" href="/خدماتنا/تزريع-اشاير-حديد/">تزريع أشاير الحديد بالإيبوكسي</a></td>
              <td>قطر السيخ، عمق الزرع، العدد، ومادة التزريع المعتمدة</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="actions-row">
        <a href="tel:+201271940742" class="btn btn-primary">اتصل للاستشارة والتسعير <bdi dir="ltr">01271940742</bdi></a>
        <a href="/اسعار-الخدمات/" class="btn btn-outline">جدول الأسعار الاسترشادية</a>
      </div>
    </div>
  </section>
</Layout>
