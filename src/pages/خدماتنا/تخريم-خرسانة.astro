---
import Layout from '../../layouts/Layout.astro';
import QuoteRequest from '../../components/QuoteRequest.astro';
import WorkGallery from '../../components/WorkGallery.astro';
const title = 'تخريم خرسانة بالكور دريل وفتحات الكور | صنايعي كور 01271940742';
const description = 'خدمة تخريم الخرسانة بالكور دريل لفتحات التكييف والغاز والسباكة والكابلات. تعرّف على عوامل السعر وتجهيز الموقع، واطلب عرض سعر من صنايعي كور: 01271940742.';
const uses = [ ['فتحات التكييف والتهوية', 'فتحات-تكييف', 'لتمرير مواسير التكييف ومسارات التهوية وفق المقاس والميل المطلوبين من فني التركيب.'], ['فتحات الغاز والشفاطات', 'فتحات-الغاز-والشفاطات', 'لتمرير مواسير الغاز أو مدخنة السخان والشفاط، بعد تحديد المواصفات من جهة التركيب.'], ['فتحات السباكة والصرف', 'فتحات-سباكة', 'لعبور مواسير المياه والصرف مع حساب الخلوص والعزل حول الماسورة.'] ];
---
<Layout title={title} description={description} navbarStyle="solid">
  <div class="breadcrumb"><div class="container"><nav aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>›</span><a href="/خدماتنا/">الخدمات</a><span>›</span><span>تخريم الخرسانة</span></nav><h1>تخريم خرسانة بالكور دريل — 01271940742</h1><p>فتحات دائرية على المقاس لتمديدات الغاز والتكييف والسباكة والكابلات، في الحوائط والأسقف والأرضيات حسب متطلبات الموقع.</p><div class="core-actions"><a href="tel:+201271940742" class="btn btn-primary">اتصل بصنايعي كور <bdi>01271940742</bdi></a><a href="#quote" class="btn btn-outline">اطلب عرض سعر</a></div></div></div>
  <section class="section"><div class="container core-guide-grid"><div class="page-content"><h2>ما هو تخريم الخرسانة بالكور؟</h2><p class="spaced-copy">الكور دريل معدة تستخدم رأسًا أسطوانيًا ماسيًا لعمل فتحة دائرية وإخراج قلب الخرسانة. يستخدم في تجهيز مسارات الخدمات داخل المباني بدل التكسير الواسع حول الفتحة المطلوبة.</p><p>يتحدد أسلوب الحفر والتثبيت والتبريد بناءً على طبيعة الخامة وموقع الفتحة. وفي الحفر الرطب، يلزم ترتيب تجميع مياه ومخلفات الحفر وحماية التشطيبات القريبة.</p><h2 class="mt-32">متى تحتاج إلى صنايعي كور؟</h2><ul><li>تجهيز فتحات مرور مواسير التكييف والصرف والمياه.</li><li>عمل فتحات الشفاطات والتهوية ومداخن السخانات بالمقاس المطلوب.</li><li>تمرير كابلات أو مواسير خدمات عبر الخرسانة.</li><li>تجهيز مجموعة فتحات لمشروع تشطيب أو تمديدات.</li></ul><p>إذا كان المطلوب فتحة باب أو نافذة مستطيلة، راجع <a class="text-link" href="/خدماتنا/قص-الخرسانة-بالمنشار/">خدمة قص الخرسانة بالمنشار</a> لاختيار الطريقة المناسبة.</p></div><aside class="card"><img src="/images/core-drilling.svg" alt="رسم توضيحي لفتحة تخريم بالكور دريل" width="1200" height="630" /><h3 class="mt-24">المكان قبل المقاس</h3><p class="spaced-copy">قبل أي تخريم في كمرة أو عمود أو سقف إنشائي، يلزم اعتماد مهندس إنشائي لمكان الفتحة وطريقة التنفيذ. استخدام الكور لا يعني تلقائيًا السماح بقطع التسليح.</p><a href="/اتصل-بنا/" class="text-link">أرسل تفاصيل موقعك ←</a></aside></div></section>
  <WorkGallery
    title="الكور دريل أثناء تجهيز الفتحات"
    description="أمثلة توضيحية لتثبيت معدة الكور وتنفيذ فتحات الجدران والأرضيات والتهوية."
    images={[
      { src: '/images/work-gallery/work-02-core-drilling-wall.webp', alt: 'كورس دريل مثبت في حائط خرساني' },
      { src: '/images/work-gallery/work-22-hilti-core-drill-wall.webp', alt: 'كور دريل احترافي مثبت على حائط خرساني' },
      { src: '/images/work-gallery/work-06-core-drilling-floor.webp', alt: 'معدة كور دريل لتخريم أرضية خرسانية' },
      { src: '/images/work-gallery/work-07-core-drilling-floor-water.webp', alt: 'كور دريل مع تبريد بالمياه أثناء التخريم' },
      { src: '/images/work-gallery/work-13-core-drill-window.webp', alt: 'تجهيز فتحة كور قرب نافذة' },
      { src: '/images/work-gallery/work-15-blue-core-drill-water.webp', alt: 'معدة كور دريل مثبتة على جدار خرساني' },
      { src: '/images/work-gallery/work-16-hydraulic-core-drill.webp', alt: 'تخريم خرساني بالكور دريل في موقع عمل' },
    ]}
  />
  <section class="section-alt"><div class="container"><div class="section-header"><h2>استخدامات فتحات الكور</h2><p>اختيار القطر يبدأ بمتطلبات التركيب الفعلية.</p></div><div class="grid-3">{uses.map(([name, slug, text]) => <a class="core-service" href={`/خدماتنا/${slug}/`}><h3>{name}</h3><p>{text}</p><span class="text-link">تفاصيل الخدمة ←</span></a>)}</div></div></section>
  <section class="section"><div class="container core-guide-grid"><div><h2>كيف تحدد مقاس فتحة الكور؟</h2><p class="spaced-copy">لا تعتمد على اسم الخدمة وحده لتحديد المقاس. اطلب من فني التركيب أو جهة الغاز القطر والموقع والارتفاع والميل المطلوب، وحدد هل القياس بالملليمتر أم بالبوصة.</p><p>القطر الخارجي للماسورة قد يختلف عن المقاس الاسمي لها، وقد تحتاج خلوصًا للعزل أو جلبة تمرير. نراجع المقاس وإمكانية تنفيذه قبل الاتفاق.</p></div><div class="check-list"><div><b>قطر الفتحة</b><p>حسب قطر التمديد والخلوص المطلوب، وليس مقاس الماسورة فقط.</p></div><div><b>عمق التخريم</b><p>سُمك الحائط أو السقف ونوع الخامة ووجود طبقات تشطيب.</p></div><div><b>موضع التنفيذ</b><p>الارتفاع وإمكانية تثبيت المعدة والوصول للجهة المقابلة وحماية المنطقة أسفلها.</p></div></div></div></section>
  <section class="section-alt"><div class="container"><div class="section-header"><h2>تجهيز الموقع وخطوات العمل</h2></div><div class="steps-grid">{[['مراجعة المطلوب','تأكيد عدد الفتحات ومقاساتها ومواقعها واعتمادها عند الحاجة.'],['فحص موضع العمل','مراجعة مسارات الخدمات وطريقة تثبيت المعدة وحماية المحيط.'],['تنفيذ الفتحة','الحفر بالمعدة والطريقة المناسبة للخامة والموقع المتفق عليه.'],['مراجعة وتسليم','مراجعة العدد والمقاس وترتيب تجميع مخلفات الحفر حسب الاتفاق.']].map(([name, text], i) => <div class="step-card"><span class="step-num">{i+1}</span><h3>{name}</h3><p>{text}</p></div>)}</div></div></section>
  <section class="section" id="quote"><div class="container core-guide-grid"><div><span class="section-label">تكلفة التخريم بالكور</span><h2>كم سعر فتحة الكور؟</h2><p class="spaced-copy">السعر يتوقف على القطر والعمق ونوع الخرسانة ودرجة صعوبة الوصول وعدد الفتحات والمنطقة. أرسل صورة واضحة وتفاصيل الفتحات لتقدير التكلفة، ثم نؤكد معك السعر ونطاق العمل قبل التنفيذ.</p><a class="text-link" href="/اسعار-الخدمات/">كيف يُحسب عرض السعر؟ ←</a><h3 class="mt-32">مناطق الخدمة</h3><p class="spaced-copy"><a class="text-link" href="/مناطق/القاهرة/">القاهرة</a>، <a class="text-link" href="/مناطق/الجيزة/">الجيزة</a>، <a class="text-link" href="/مناطق/التجمع-الخامس/">التجمع الخامس</a>، و<a class="text-link" href="/مناطق/اكتوبر-وزايد/">أكتوبر والشيخ زايد</a>. تواصل لتأكيد تغطية عنوانك والموعد المتاح.</p></div><QuoteRequest /></div></section>
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Service','@id':'https://sanayeicor.com/خدماتنا/تخريم-خرسانة/#service',name:'تخريم خرسانة بالكور دريل',serviceType:'تخريم الخرسانة وفتحات الكور',description,url:'https://sanayeicor.com/خدماتنا/تخريم-خرسانة/',provider:{'@id':'https://sanayeicor.com/#business'},areaServed:['القاهرة','الجيزة','التجمع الخامس','6 أكتوبر','الشيخ زايد']})} />
</Layout>
