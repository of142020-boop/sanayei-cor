---
import Layout from '../../layouts/Layout.astro';
import QuoteRequest from '../../components/QuoteRequest.astro';
import WorkGallery from '../../components/WorkGallery.astro';

const siteUrl = Astro.site?.origin || 'https://sanayeicor.com';
const pageUrl = `${siteUrl}/خدماتنا/تخريم-خرسانة/`;
const title = 'تخريم خرسانة بالكور دريل وفتحات كور خرسانة | 01271940742';
const description = 'مقاول فتحات كور وتخريم الخرسانة المسلحة بالكور دريل في مصر: فتح كور للحوائط والأسقف الفلات سلاب للتكييف والغاز والسباكة بأقطار 1–12 بوصة. 01271940742.';

const diameterSpecs = [
  { inch: '1 – 2 بوصة (25–50 مم)', usage: 'مواسير تغذية المياه، كابلات الكهرباء، ومسار تكييف سبليت صغير', depth: 'حتى 40 سم', price: '200 – 350 ج.م' },
  { inch: '2.5 – 3 بوصة (65–75 مم)', usage: 'تكييف سبليت بالعزل والصرف، صرف الغسالات والأحواض', depth: 'حتى 50 سم', price: '250 – 350 ج.م' },
  { inch: '4 بوصة (100 مم)', usage: 'هواية الغاز الطبيعي، مخرج شفاط حمام مخفي، وصرف 3 بوصة', depth: 'حتى 60 سم', price: '250 – 400 ج.م' },
  { inch: '5 – 6 بوصة (125–150 مم)', usage: 'مدخنة سخان غاز، دكت شفاط مطبخ هرمي/بلت إن، عمود صرف 4 بوصة', depth: 'حتى 70 سم', price: '350 – 550 ج.م' },
  { inch: '7 – 8 بوصة (180–200 مم)', usage: 'دكت التكييف المركزي والكونسيلد وصواعد المشروعات', depth: 'حسب القطاع', price: '600 – 850 ج.م' },
  { inch: '9 – 12 بوصة (225–300 مم)', usage: 'فتحات الأسقف الكبرى، التهوية الصناعية، وخطوط الحريق', depth: 'حسب الاعتماد', price: '900+ ج.م بالمعاينة' },
];

const relatedUses = [
  { name: 'فتحات التكييف والتهوية', slug: 'فتحات-تكييف', text: 'فتحات 2 إلى 8 بوصة لمواسير النحاس والدكت مع ضبط ميل الصرف وحماية الواجهة.' },
  { name: 'فتحات الغاز ومداخن السخانات', slug: 'فتحات-الغاز-والشفاطات', text: 'تنفيذ مطابق لمعاينة شركة الغاز لماسورة الغاز والهواية ومدخنة السخان بدون كسر السيراميك.' },
  { name: 'فتحات السباكة والصرف', slug: 'فتحات-سباكة', text: 'فتحات أسقف فلات سلاب وحوائط لمواسير الصرف والتغذية مع خلوص الجلبة والعزل.' },
];

const faqs: [string, string][] = [
  ['ما هو تخريم الخرسانة بالكور دريل وكيف يعمل؟', 'الكور دريل ماكينة حفر أسطوانية مزودة بتاج ماسي (بنطة كور) تدور بتبريد مائي لقطع الخرسانة المسلحة وحديد التسليح وإخراج قلب أسطواني ناعم دون طرق أو اهتزازات، مما يحافظ على سلامة المبنى والتشطيبات.'],
  ['هل يمكن عمل فتحات كور في السقف الخرساني (فتحات السقف)؟', 'نعم، ننفذ فتحات السقف الفلات سلاب والهوردي لتمديدات الصرف والتكييف المركزي، بشرط مراجعة واعتماد موضع الفتحة من مهندس إنشائي لتفادي الكمرات الرئيسية ومناطق إجهاد الأعمدة.'],
  ['ما الفرق بين التخريم الرطب والتخريم الجاف بالكور؟', 'التخريم الرطب يستخدم ضخ مياه مستمرًا لتبريد التاج الماسي ومنع الغبار وإنجاز الخرسانة المسلحة بسرعة، بينما يُستخدم التخريم الجاف في حالات محددة بالبلوك أو الطوب فقط مع شفاط غبار.'],
  ['هل يتأثر السيراميك أو الرخام عند عمل فتحة كور؟', 'لا، عند إلغاء الدقاق وتثبيت قاعدة الماكينة واستخدام تاج ماسي مخصص مع التبريد المائي، تخرج الفتحة دائرية صافية الحواف في السيراميك والبورسلين والرخام دون كسور.'],
  ['كم يستغرق تنفيذ فتحة الكور الواحدة؟', 'تستغرق الفتحة القياسية في جدار خرساني بسُمك 20–25 سم ما بين 15 و35 دقيقة شامل التثبيت والحفر والتنظيف، وتختلف المدة حسب القطر وكثافة الحديد وسُمك العنصر.'],
];

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'تخريم خرسانة وفتحات كور بالكور دريل الماسي',
  serviceType: 'تخريم الخرسانة المسلحة بالكور دريل',
  description,
  url: pageUrl,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: [
    { '@type': 'City', name: 'القاهرة' },
    { '@type': 'City', name: 'الجيزة' },
    { '@type': 'City', name: 'التجمع الخامس' },
    { '@type': 'City', name: '6 أكتوبر والشيخ زايد' },
    { '@type': 'City', name: 'الإسكندرية' },
    { '@type': 'Country', name: 'مصر' },
  ],
};
---

<Layout
  title={title}
  description={description}
  faqs={faqs}
  extraGraph={[serviceSchema]}
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <a href="/خدماتنا/">الخدمات</a><span>›</span>
        <span>تخريم خرسانة بالكور</span>
      </nav>
      <h1>تخريم خرسانة وفتحات كور بالكور دريل في مصر — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">
        مقاول فتحات كور وتخريم الخرسانة المسلحة بالكور دريل الماسي للحوائط والأسقف والأرضيات بأقطار من 1 إلى 12 بوصة: فتحات تكييف، غاز طبيعي، سباكة، شفاطات، وكابلات بدون تكسير أو شروخ.
      </p>
      <div class="actions-row">
        <a href="tel:+201271940742" class="btn btn-primary">اتصل الآن <bdi dir="ltr">01271940742</bdi></a>
        <a href="#quote" class="btn btn-outline">اطلب تسعير فتحات الكور</a>
      </div>
      <nav class="banner-subnav" aria-label="أقسام الصفحة">
        <a href="#diameters">جدول الأقطار والأسعار</a>
        <a href="#slabs">فتحات السقف والحوائط</a>
        <a href="#wet-vs-dry">الحفر الرطب والجاف</a>
        <a href="#questions">الأسئلة الشائعة</a>
      </nav>
    </div>
  </header>

  <section class="section-surface" id="overview">
    <div class="container split-wide-first">
      <div class="prose">
        <h2>ما هو كور تخريم الخرسانة ولماذا يُعد الحل الهندسي الآمن؟</h2>
        <p>
          <strong>كور تخريم الخرسانة (Core Drilling)</strong> هو نظام حفر ميكانيكي دقيق يعتمد على ماكينة مثبتة بقاعدة فولاذية وتاج أسطواني مرصّع بالألماس الصناعي (Diamond Core Bit). يدور التاج مع تبريد مائي منتظم ليقطع الخرسانة المسلحة وحديد التسليح بكفاءة عالية ويستخرج قلبًا أسطوانيًا سليمًا بقطر مطابق للمطلوب دون أي طرق أو اهتزاز.
        </p>
        <p>
          عكس التكسير اليدوي بالهيلتي أو الشاكوش الذي يسبب شروخًا شعرية في الجدران وتلفًا في الدهانات والسيراميك ويتطلب أعمال ترميم ومحارة مكلفة، يمنحك <strong>فتح كور</strong> بالماكينة الماسية فتحة دائرية صافية الحواف جاهزة فورًا لتركيب المواسير أو الدكت أو جلبة العزل.
        </p>

        <h2>متى تحتاج إلى مقاول فتحات كور متخصص؟</h2>
        <ul>
          <li>تنفيذ فتحات التكييف السبليت والكونسيلد ومجاري التكييف المركزي في الحوائط والأسقف.</li>
          <li>عمل فتحات الغاز الطبيعي، هواية المطبخ، ومداخن سخانات الغاز بالمقاس المعتمد من شركة الغاز.</li>
          <li>تأسيس فتحات مواسير الصرف الصحي والتغذية في الحمامات والمطابخ والأسقف الفلات سلاب.</li>
          <li>تجهيز مخرج دائري لمدخنة شفاط المطبخ أو شفاط الحمام المخفي في الخرسانة أو السيراميك.</li>
          <li>تمرير كابلات الجهد المتوسط ومواسير مكافحة الحريق في المصانع والمولات والمشروعات الكبرى.</li>
          <li>استخراج عينات قلب خرساني (Core Test) للاختبارات المعملية وفق إشراف المهندس الاستشاري.</li>
        </ul>
        <p>
          إذا كان المطلوب فتحة مستطيلة لباب أو شباك أو سلم، فالحل المناسب هو خدمة <a href="/خدماتنا/قص-الخرسانة-بالمنشار/">قص الخرسانة بالمنشار الماسي</a> بدل التخريم الدائري.
        </p>
      </div>

      <aside class="card-muted">
        <img src="/images/work-gallery/work-02-core-drilling-wall.webp" alt="ماكينة كور دريل مثبتة على حائط خرساني لتنفيذ فتحات التمديدات" width="1600" height="1067" class="article-cover" />
        <h3>بروتوكول السلامة الإنشائية قبل الحفر</h3>
        <ul class="bullet-list">
          <li>فحص مسارات الكهرباء والمياه القائمة قبل تثبيت الماكينة.</li>
          <li>عدم تخريم أي عمود أو كمرة رئيسية أو سقف حامل دون موافقة واعتماد مهندس إنشائي.</li>
          <li>تثبيت القاعدة بمسامير فولاذية أو مضخة تفريغ (Vacuum) لمنع أي انحراف في القطر.</li>
          <li>تجميع مياه التبريد وقلب الخرسانة لحماية التشطيبات والأرضيات المحيطة.</li>
        </ul>
        <div class="mt-16">
          <a href="/مقالات/core-drilling-guide/" class="text-link">اقرأ دليل الكور دريل الكامل ←</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" id="diameters">
    <div class="container">
      <div class="section-header">
        <span class="section-label">المواصفات والأقطار القياسية</span>
        <h2>جدول أقطار فتحات الكور والاستخدامات والأسعار الاسترشادية</h2>
        <p>يُحدد قطر بنطة الكور بناءً على القطر الخارجي للماسورة مع إضافة خلوص مناسب للجلبة والعزل، لا على الاسم التجاري للماسورة فقط.</p>
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th scope="col">قطر فتحة الكور</th>
              <th scope="col">الاستخدامات الميدانية الأساسية</th>
              <th scope="col">عمق التخريم الشائع</th>
              <th scope="col">السعر الاسترشادي للفتحة</th>
            </tr>
          </thead>
          <tbody>
            {diameterSpecs.map(row => (
              <tr>
                <td><strong>{row.inch}</strong></td>
                <td>{row.usage}</td>
                <td>{row.depth}</td>
                <td><strong>{row.price}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-caption">تُراجع الأسعار النهائية وفق سُمك الخرسانة، كثافة التسليح، العدد الإجمالي للفتحات، والمنطقة. راجع <a class="text-link" href="/اسعار-الخدمات/">صفحة أسعار فتحات الكور وقص الخرسانة</a> لمزيد من التفاصيل.</p>
    </div>
  </section>

  <section class="section-surface" id="slabs">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">تخريم الأسقف والجدران</span>
        <h2>فتحات السقف الفلات سلاب والكمرات: ضوابط التنفيذ الآمن</h2>
        <p class="spaced-copy">
          تنفيذ <strong>فتحات السقف</strong> في المباني السكنية والإدارية (لتمرير أعمدة صرف جديدة أو صواعد تكييف وكابلات) يختلف جذريًا عن تخريم الحوائط القاطعة. في البلاطات اللاكمرية (Flat Slab) تُمنع الفتحات تمامًا في نطاق شرائح الأعمدة الحرجة (Punching Zone) دون مراجعة إنشائية.
        </p>
        <p class="spaced-copy">
          قبل بدء الحفر الرأسي في السقف، نقوم بتأمين الفراغ أسفل نقطة الخروج وتركيب حوض تجميع لقلب الخرسانة ومياه التبريد، ثم تنفيذ الحفر بسرعة دوران مضبوطة تمنع تشرخ طبقة البياض أو السيراميك بالدور السفلي.
        </p>
      </div>
      <div class="check-list" id="wet-vs-dry">
        <div>
          <b>الحفر الرطب بالماء (Wet Coring) — للخرسانة المسلحة</b>
          <p>الأسلوب المعتمد للخرسانة المسلحة والسيراميك والرخام؛ يبرد الألماس، يضاعف سرعة القطع في الحديد، ويمنع تطاير الغبار داخل الشقق المشطبة.</p>
        </div>
        <div>
          <b>الحفر الجاف (Dry Coring) — للطوب والبلوك فقط</b>
          <p>يُستخدم في المباني الطوبية أو البلوك غير المسلح عند تعذر استخدام المياه مع شفاط أتربة، ولا يُنصح به في الخرسانة المسلحة السميكة.</p>
        </div>
        <div>
          <b>التخريم المائل والعميق (حتى 100 سم+)</b>
          <p>باستخدام وصلات إطالة (Extensions) لماكينة الكور دريل، يمكن تنفيذ فتحات مائلة لصرف التكييف أو اختراق جدران حجرية وأسقف مزدوجة السمك.</p>
        </div>
      </div>
    </div>
  </section>

  <WorkGallery
    title="تنفيذ فتحات الكور في الجدران والأسقف"
    description="لقطات ميدانية لتثبيت ماكينة الكور دريل الهيلتي والهيدروليك في الحوائط والأرضيات والأسقف."
    images={[
      { src: '/images/work-gallery/work-22-hilti-core-drill-wall.webp', alt: 'كور دريل احترافي مثبت على حائط خرساني' },
      { src: '/images/work-gallery/work-06-core-drilling-floor.webp', alt: 'تخريم سقف وأرضية خرسانية بالكور دريل' },
      { src: '/images/work-gallery/work-07-core-drilling-floor-water.webp', alt: 'تخريم خرسانة مع تبريد مائي مستمر' },
      { src: '/images/work-gallery/work-13-core-drill-window.webp', alt: 'تنفيذ فتحة كور قرب نافذة وواجهة' },
      { src: '/images/work-gallery/work-15-blue-core-drill-water.webp', alt: 'ماكينة كور دريل مثبتة على جدار مسلح' },
      { src: '/images/work-gallery/work-16-hydraulic-core-drill.webp', alt: 'تخريم خرساني عميق بالكور في موقع عمل' },
    ]}
  />

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">تخصصات فتحات الكور</span>
        <h2>تطبيقات تخريم الخرسانة حسب نوع التمديد</h2>
      </div>
      <div class="grid-3">
        {relatedUses.map(item => (
          <a class="service-card" href={`/خدماتنا/${item.slug}/`}>
            <h3>{item.name}</h3>
            <p>{item.text}</p>
            <span class="text-link">تفاصيل الخدمة ←</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-surface" id="questions">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">أسئلة فنية شائعة</span>
        <h2>كل ما تريد معرفته عن تخريم الخرسانة بالكور</h2>
        <p class="spaced-copy">إجابات مباشرة حول السلامة الإنشائية، التبريد المائي، السيراميك، ومدة التنفيذ.</p>
        <div class="mt-16">
          <a href="/مقالات/core-machine-prices/" class="text-link">لماذا الاستعانة بصنايعي كور أوفر من شراء الماكينة؟ ←</a>
        </div>
      </div>
      <div class="native-faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt" id="quote">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">اطلب مقاول فتحات كور</span>
        <h2>تواصل معنا لتأكيد سعر وموعد تخريم الخرسانة</h2>
        <p class="spaced-copy">
          نغطي <a class="text-link" href="/مناطق/القاهرة/">القاهرة</a>، <a class="text-link" href="/مناطق/الجيزة/">الجيزة</a>، <a class="text-link" href="/مناطق/التجمع-الخامس/">التجمع الخامس</a>، <a class="text-link" href="/مناطق/اكتوبر-وزايد/">6 أكتوبر والشيخ زايد</a>، <a class="text-link" href="/مناطق/الإسكندرية/">الإسكندرية</a> وباقي المحافظات. اتصل على <a class="text-link" href="tel:+201271940742"><bdi dir="ltr">01271940742</bdi></a> أو أرسل بيانات الفتحات الآن.
        </p>
        <div class="mt-16">
          <a href="/مقالات/core-drilling-uses/" class="text-link">دليل تحديد مقاس فتحة الكور قبل الطلب ←</a>
        </div>
      </div>
      <QuoteRequest initialService="تخريم خرسانة بالكور دريل" />
    </div>
  </section>
</Layout>
