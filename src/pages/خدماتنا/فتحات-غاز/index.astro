---
import Layout from "../../../layouts/Layout.astro";

const title = "فتحات كور غاز طبيعي | صنايعي كور غاز متخصص | 01055550195";
const description = "فتحات كور الغاز الطبيعي بالقطر المعتمد (2 بوصة). فتحة عداد غاز وسخان ومدخنة بوتاجاز. بدون اهتزاز وبدون غبار — صنايعي كور غاز موثوق. اتصل 01055550195";
---
<Layout title={title} description={description} ogImage="/images/فتحات-كور-للجدران.webp" navbarStyle="solid">
  <div class="breadcrumb">
    <div class="container">
      <nav aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span class="separator">›</span>
        <a href="/خدماتنا/">الخدمات</a><span class="separator">›</span>
        <span>فتحات غاز طبيعي</span>
      </nav>
      <h1>فتحات كور الغاز الطبيعي</h1>
      <p>فتحات الغاز الطبيعي والسخانات والبوتاجاز بالقطر المعتمد من شركة الغاز بدون اهتزاز أو غبار</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:60px;">
        <div>
          <h2>فتحة كور <strong style="color:var(--primary)">الغاز الطبيعي</strong></h2>
          <p style="color:var(--text-muted); margin:16px 0;">تحتاج إلى فتحة كور الغاز لتمرير أنبوب الغاز الطبيعي من خلال الجدار الخرساني. القطر المعتمد من شركة الغاز المصرية هو <strong>2 بوصة (5 سم)</strong>، وتحتاج كذلك إلى غطاء لحماية الأنبوب.</p>
          <h2 style="margin-top:24px;">أنواع فتحات كور الغاز</h2>
          <div class="page-content"><ul>
            <li>فتحة عداد الغاز الطبيعي (2 بوصة)</li>
            <li>فتحة مدخنة السخان (شفاط عادم الغاز)</li>
            <li>فتحة تمرير أنبوب البوتاجاز من الخارج</li>
            <li>فتحات تمديدات الغاز بين الغرف</li>
          </ul></div>
          <div class="card" style="margin-top:24px; background:rgba(245,158,11,0.05); border-color:rgba(245,158,11,0.3);">
            <p style="font-size:0.9rem;">⚠️ <strong style="color:var(--primary)">تنبيه:</strong> القطر المعتمد من شركة الغاز المصرية لفتحة أنبوب الغاز هو <strong>2 بوصة (5 سم)</strong>. نحن نضمن التنفيذ وفق المعايير المعتمدة.</p>
          </div>
        </div>
        <div class="card">
          <h3 style="margin-bottom:20px; color:var(--primary);">💰 أسعار فتحات كور الغاز</h3>
          <table class="pricing-table">
            <thead><tr><th>نوع الفتحة</th><th>القطر</th><th>السعر (جنيه)</th></tr></thead>
            <tbody>
              <tr><td>فتحة عداد الغاز</td><td>2 بوصة</td><td>150 - 250 ج</td></tr>
              <tr><td>مدخنة السخان</td><td>4 بوصة</td><td>200 - 350 ج</td></tr>
              <tr><td>فتحة بوتاجاز</td><td>2-3 بوصة</td><td>150 - 280 ج</td></tr>
              <tr><td>تمديد أنابيب غاز</td><td>حسب الطلب</td><td>يُقدّر بالمعاينة</td></tr>
            </tbody>
          </table>
          <a href="tel:+201055550195" class="btn btn-primary w-full" style="margin-top:20px;" id="gas-cta">📞 اتصل للمعاينة المجانية</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section cta-section" aria-labelledby="gas-final-heading">
    <div class="container">
      <div class="cta-inner">
        <h2 id="gas-final-heading">تحتاج <span style="background:var(--grad-primary); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">فتحة كور غاز</span> الآن؟</h2>
        <p>صنايعي كور غاز متخصص يصلك اليوم. نضمن القطر المعتمد والتنفيذ الآمن.</p>
        <div class="cta-btns">
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="gas-final-call">📞 01055550195</a>
          <a href="https://wa.me/201055550195" class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer" id="gas-final-wa">💬 واتساب</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
