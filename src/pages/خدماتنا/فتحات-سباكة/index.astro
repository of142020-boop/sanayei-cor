---
import Layout from "../../../layouts/Layout.astro";

const title = "فتحات كور السباكة والصرف الصحي | صنايعي كور سباكة | 01055550195";
const description = "فتحات كور لتمديدات السباكة والصرف الصحي في الجدران والأرضيات الخرسانية. إضافة حمامات ومطابخ — اتصل 01055550195";
---
<Layout title={title} description={description} ogImage="/images/فتحات-كور-للسباكة.webp" navbarStyle="solid">
  <div class="breadcrumb">
    <div class="container">
      <nav aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span class="separator">›</span>
        <a href="/خدماتنا/">الخدمات</a><span class="separator">›</span>
        <span>فتحات سباكة وصرف</span>
      </nav>
      <h1>فتحات كور السباكة والصرف الصحي</h1>
      <p>تمديدات السباكة والصرف الصحي في الجدران والأرضيات الخرسانية بدقة عالية وبدون اهتزاز</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:60px;">
        <div>
          <h2>فتحات كور <strong style="color:var(--primary)">السباكة والصرف</strong></h2>
          <p style="color:var(--text-muted); margin:16px 0;">سواء كنت تريد إضافة حمام جديد، تمديد خطوط المياه، أو تغيير مسار مواسير الصرف الصحي، فنحن نعمل الفتحات المطلوبة في الخرسانة بأقطار متعددة وبدون إلحاق أي ضرر بالهيكل.</p>
          <h2 style="margin-top:24px;">الفتحات الشائعة في السباكة</h2>
          <div class="page-content"><ul>
            <li>فتحات أرضية للصرف الصحي في الحمامات (4-6 بوصة)</li>
            <li>فتحات جدارية لتمرير مواسير المياه (1-2 بوصة)</li>
            <li>فتحات الصرف في المطابخ (3-4 بوصة)</li>
            <li>فتحات تمديد الغسالة والغسيل (2-3 بوصة)</li>
            <li>فتحات بين الطوابق لتمرير الماسورة الرئيسية</li>
          </ul></div>
        </div>
        <div class="card">
          <h3 style="margin-bottom:20px; color:var(--primary);"> أسعار فتحات السباكة</h3>
          <table class="pricing-table">
            <thead><tr><th>نوع الفتحة</th><th>القطر</th><th>السعر (جنيه)</th></tr></thead>
            <tbody>
              <tr><td>صرف حمام (أرضية)</td><td>4-6 بوصة</td><td>250 - 450 ج</td></tr>
              <tr><td>تمرير ماسورة مياه</td><td>1-2 بوصة</td><td>150 - 280 ج</td></tr>
              <tr><td>صرف مطبخ</td><td>3-4 بوصة</td><td>200 - 380 ج</td></tr>
              <tr><td>ماسورة رئيسية بين الطوابق</td><td>6+ بوصة</td><td>400 - 700 ج</td></tr>
            </tbody>
          </table>
          <a href="tel:+201055550195" class="btn btn-primary w-full" style="margin-top:20px;" id="plumbing-cta"> اتصل للمعاينة المجانية</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section cta-section" aria-labelledby="plumbing-final-heading">
    <div class="container">
      <div class="cta-inner">
        <h2 id="plumbing-final-heading">تحتاج <span style="background:var(--grad-primary); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">فتحات سباكة</span>؟ نحن الحل!</h2>
        <div class="cta-btns">
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="plumbing-final-call"> 01055550195</a>
          <a href="https://wa.me/201055550195" class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer" id="plumbing-final-wa"> واتساب</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
