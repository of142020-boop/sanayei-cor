---
import Layout from "../../../layouts/Layout.astro";

const title = "فتحات كور التكييف والتهوية | صنايعي كور تكييف | 01055550195";
const description = "فتحات كور مخصصة لوحدات التكييف السبليت والمركزي وشفاطات الحمام والمطبخ. بدون غبار وبدون اهتزاز — اتصل 01055550195";
---
<Layout title={title} description={description} ogImage="/images/فتحات-تهوية-وتكييف.webp" navbarStyle="solid">
  <div class="breadcrumb">
    <div class="container">
      <nav aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span class="separator">›</span>
        <a href="/خدماتنا/">الخدمات</a><span class="separator">›</span>
        <span>فتحات تكييف وتهوية</span>
      </nav>
      <h1>فتحات كور التكييف والتهوية</h1>
      <p>فتحات مخصصة لوحدات التكييف السبليت والمركزي والشفاطات وفتحات التهوية بأي قطر مطلوب</p>
    </div>
  </div>
  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:60px;">
        <div>
          <h2>فتحات كور <strong style="color:var(--primary)">التكييف والتهوية</strong></h2>
          <p style="color:var(--text-muted); margin:16px 0;">يحتاج كل تكييف سبليت إلى فتحتين: فتحة لتمرير مواسير الفريون وكابل الكهرباء، وغالباً فتحة إضافية لتصريف الماء. التكييف المركزي يحتاج فتحات أكبر في الأسقف.</p>
          <h2 style="margin-top:24px;">أنواع الفتحات الشائعة</h2>
          <div class="page-content"><ul>
            <li>فتحة مواسير تكييف سبليت في الجدار (3 بوصة)</li>
            <li>فتحة مواسير تكييف مركزي في السقف (4-6 بوصة)</li>
            <li>فتحة شفاط حمام أو مطبخ في السقف الخرساني</li>
            <li>فتحات فتحات التهوية للمداخن والأماكن المغلقة</li>
            <li>فتحة تصريف مياه التكييف في الجدار</li>
          </ul></div>
        </div>
        <div class="card">
          <h3 style="margin-bottom:20px; color:var(--primary);"> أسعار فتحات كور التكييف</h3>
          <table class="pricing-table">
            <thead><tr><th>نوع الفتحة</th><th>القطر</th><th>السعر (جنيه)</th></tr></thead>
            <tbody>
              <tr><td>تكييف سبليت (جدار)</td><td>3 بوصة</td><td>200 - 350 ج</td></tr>
              <tr><td>تكييف مركزي (سقف)</td><td>4-6 بوصة</td><td>280 - 450 ج</td></tr>
              <tr><td>شفاط حمام (سقف)</td><td>4 بوصة</td><td>220 - 380 ج</td></tr>
              <tr><td>شفاط مطبخ (سقف)</td><td>6 بوصة</td><td>280 - 450 ج</td></tr>
              <tr><td>فتحة تهوية</td><td>2-4 بوصة</td><td>150 - 300 ج</td></tr>
            </tbody>
          </table>
          <a href="tel:+201055550195" class="btn btn-primary w-full" style="margin-top:20px;" id="ac-cta"> اتصل للمعاينة المجانية</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section cta-section" aria-labelledby="ac-final-heading">
    <div class="container">
      <div class="cta-inner">
        <h2 id="ac-final-heading">تركيب <span style="background:var(--grad-primary); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">تكييف جديد</span>؟ نعمل الفتحة الآن!</h2>
        <div class="cta-btns">
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="ac-final-call"> 01055550195</a>
          <a href="https://wa.me/201055550195" class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer" id="ac-final-wa"> واتساب</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
