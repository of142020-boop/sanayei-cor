---
import Layout from "../../layouts/Layout.astro";

const title = "تخريم خرسانة بالكور دريل | صنايعي كور متخصص | 01055550195";
const description = "تخريم الخرسانة المسلحة بالكور دريل بدقة هندسية عالية. فتحات غاز وتكييف وسباكة وكهرباء في جميع المحافظات. معدات ألمانية Hilti - بدون اهتزازات - اتصل 01055550195";
---

<Layout title={title} description={description} ogImage="/images/فتحات-كور-للجدران.webp" navbarStyle="solid">

  <div class="breadcrumb">
    <div class="container">
      <nav aria-label="مسار التنقل">
        <a href="/">الرئيسية</a>
        <span class="separator">›</span>
        <a href="/خدماتنا/">الخدمات</a>
        <span class="separator">›</span>
        <span>تخريم خرسانة بالكور</span>
      </nav>
      <h1>تخريم خرسانة بالكور دريل</h1>
      <p>عمل فتحات دائرية دقيقة في الخرسانة المسلحة بتقنية Diamond Core Drilling الألمانية</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid-2" style="gap:60px; align-items:start;">
        <div>
          <h2>ما هو <strong style="color:var(--primary)">تخريم الخرسانة بالكور دريل</strong>؟</h2>
          <p style="color:var(--text-muted); margin:16px 0;">تخريم الخرسانة بالكور (Core Drilling) هو تقنية حديثة تُستخدم لعمل فتحات دائرية مثالية في الجدران والأسقف والأرضيات الخرسانية المسلحة، باستخدام رأس حفر ماسي دوار (Diamond Core Bit) مزوداً بالمياه.</p>

          <h2 style="margin-top:32px;">متى تحتاج إلى <strong style="color:var(--primary)">صنايعي كور</strong>؟</h2>
          <div class="page-content">
            <ul>
              <li>عند تركيب خط الغاز الطبيعي أو مدخنة السخان</li>
              <li>عند تمديد مواسير الصرف الصحي أو السباكة</li>
              <li>عند تركيب وحدة تكييف سبليت أو مركزي</li>
              <li>عند تركيب شفاط حمام أو مطبخ في السقف</li>
              <li>عند تمديد كابلات الكهرباء أو الإنترنت في الخرسانة</li>
              <li>عند تركيب كاميرات المراقبة بكابل مخفي</li>
              <li>عند تركيب قضبان الدرابزين في الأرضيات</li>
            </ul>
          </div>

          <h2 style="margin-top:32px;">خطوات تنفيذ <strong style="color:var(--primary)">فتحة الكور</strong> عندنا</h2>
          <div class="features-list" style="margin-top:16px;">
            <div class="feature-item">
              <div class="feature-icon">1⃣</div>
              <div class="feature-text">
                <h4>تحديد موقع الفتحة بدقة</h4>
                <p>نستخدم كاشف أسلاك كهربائية وحديد تسليح لتحديد الموقع الآمن للحفر</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">2⃣</div>
              <div class="feature-text">
                <h4>تثبيت المعدة بدقة</h4>
                <p>تثبيت حامل الكور دريل بشكل محكم لضمان قطر مثالي ومستقيم تماماً</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">3⃣</div>
              <div class="feature-text">
                <h4>الحفر الرطب (Wet Drilling)</h4>
                <p>ضخ المياه أثناء الحفر لتبريد الرأس الماسي وإزالة الغبار وحماية الخرسانة</p>
              </div>
            </div>
            <div class="feature-item">
              <div class="feature-icon">4⃣</div>
              <div class="feature-text">
                <h4>التنظيف والتسليم</h4>
                <p>إزالة جميع مخلفات الحفر وتسليم الموقع نظيفاً تماماً</p>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div class="card" style="margin-bottom:24px;">
            <h3 style="margin-bottom:20px; color:var(--primary);"> أقطار الفتحات المتاحة</h3>
            <table class="pricing-table">
              <thead>
                <tr>
                  <th scope="col">القطر (بوصة)</th>
                  <th scope="col">القطر (سم)</th>
                  <th scope="col">الاستخدام الشائع</th>
                </tr>
              </thead>
              <tbody>
                <tr><td>1 بوصة</td><td>2.5 سم</td><td>كوندويت كهرباء صغير</td></tr>
                <tr><td>2 بوصة</td><td>5 سم</td><td>غاز طبيعي  الأكثر طلباً</td></tr>
                <tr><td>3 بوصة</td><td>7.5 سم</td><td>تكييف، سباكة خفيفة</td></tr>
                <tr><td>4 بوصة</td><td>10 سم</td><td>صرف صحي، تكييف مركزي</td></tr>
                <tr><td>6 بوصة</td><td>15 سم</td><td>صرف صحي كبير، شفاط</td></tr>
                <tr><td>8-12 بوصة</td><td>20-30 سم</td><td>مشاريع خاصة وكبيرة</td></tr>
              </tbody>
            </table>
          </div>

          <div class="card">
            <h3 style="margin-bottom:16px;"> لماذا نحن الأفضل؟</h3>
            <div class="features-list" style="gap:12px;">
              <div class="feature-item" style="padding:14px;">
                <div class="feature-icon" style="width:36px; height:36px; font-size:1rem;"></div>
                <div class="feature-text">
                  <h4 style="font-size:0.9rem;">خبرة +8 سنوات</h4>
                </div>
              </div>
              <div class="feature-item" style="padding:14px;">
                <div class="feature-icon" style="width:36px; height:36px; font-size:1rem;">🇩🇪</div>
                <div class="feature-text">
                  <h4 style="font-size:0.9rem;">معدات ألمانية Hilti & Tyrolit</h4>
                </div>
              </div>
              <div class="feature-item" style="padding:14px;">
                <div class="feature-icon" style="width:36px; height:36px; font-size:1rem;"></div>
                <div class="feature-text">
                  <h4 style="font-size:0.9rem;">تنفيذ في نفس اليوم</h4>
                </div>
              </div>
              <div class="feature-item" style="padding:14px;">
                <div class="feature-icon" style="width:36px; height:36px; font-size:1rem;"></div>
                <div class="feature-text">
                  <h4 style="font-size:0.9rem;">معاينة مجانية</h4>
                </div>
              </div>
            </div>
            <a href="tel:+201055550195" class="btn btn-primary w-full" style="margin-top:20px;" id="core-page-cta">
               اتصل الآن - 01055550195
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta-section" aria-labelledby="core-cta-heading">
    <div class="container">
      <div class="cta-inner">
        <h2 id="core-cta-heading">هل تحتاج <span style="background:var(--grad-primary); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;">صنايعي كور</span> الآن؟</h2>
        <p>اتصل بنا الآن وسيصلك فريقنا في أسرع وقت ممكن مع ضمان الجودة والدقة</p>
        <div class="cta-btns">
          <a href="tel:+201055550195" class="btn btn-primary btn-lg" id="core-final-call"> 01055550195</a>
          <a href="https://wa.me/201055550195" class="btn btn-outline btn-lg" target="_blank" rel="noopener noreferrer" id="core-final-wa"> واتساب</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "تخريم خرسانة بالكور دريل",
  "provider": {
    "@type": "LocalBusiness",
    "name": "صنايعي كور",
    "telephone": "+201055550195"
  },
  "description": "عمل فتحات دائرية دقيقة في الخرسانة المسلحة بتقنية Diamond Core Drilling",
  "areaServed": { "@type": "Country", "name": "مصر" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "أنواع فتحات الكور",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحة كور غاز طبيعي - 2 بوصة" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحة كور تكييف - 3 إلى 4 بوصة" }},
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "فتحة كور سباكة - 4 إلى 6 بوصة" }}
    ]
  }
})} />
