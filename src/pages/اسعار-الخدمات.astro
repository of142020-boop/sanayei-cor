---
import Layout from '../layouts/Layout.astro';
import QuoteRequest from '../components/QuoteRequest.astro';

const corePrices = [
  { diameter: '1 – 2 بوصة (25 – 50 مم)', use: 'مواسير تغذية المياه، الكابلات، وفتحة تكييف سبليت صغيرة', wall: '200 – 350 ج.م', slab: '250 – 400 ج.م' },
  { diameter: '3 – 4 بوصة (75 – 100 مم)', use: 'فتحات صرف صحي، هواية الغاز الطبيعي، وشفاط حمام مخفي', wall: '250 – 400 ج.م', slab: '300 – 450 ج.م' },
  { diameter: '5 – 6 بوصة (125 – 150 مم)', use: 'مدخنة سخان غاز، دكت شفاط مطبخ، وعمود صرف رئيسي 4 بوصة', wall: '350 – 550 ج.م', slab: '450 – 650 ج.م' },
  { diameter: '7 – 8 بوصة (180 – 200 مم)', use: 'دكت تكييف مركزي وكونسيلد ومخارج تهوية كبيرة', wall: '600 – 850 ج.م', slab: '700 – 950 ج.م' },
  { diameter: '9 – 12 بوصة (225 – 300 مم)', use: 'فتحات أسقف المشروعات، صواعد الحريق، والتهوية الصناعية', wall: '900+ ج.م', slab: 'حسب العمق والمعاينة' },
];

const cuttingPrices = [
  { service: 'قص خرسانة بالمنشار الجداري (سُمك 10 – 20 سم)', unit: 'بالمتر الطولي لخط القص', range: '500 – 800 ج.م / متر', notes: 'فتح أبواب وشبابيك وتعديلات حوائط خرسانية' },
  { service: 'قص خرسانة مسلحة سميكة (سُمك 25 – 40 سم)', unit: 'بالمتر الطولي لخط القص', range: '850 – 1,300 ج.م / متر', notes: 'جدران حاملة وأسقف فلات سلاب بعد الاعتماد الهندسي' },
  { service: 'قص بالسلك الماسي (كمرات وقواعد ضخمة)', unit: 'بالمتر المربع للقطع', range: 'يُحدد بالمعاينة والرسومات', notes: 'للقطاعات التي تتجاوز عمق المنشار الجداري' },
  { service: 'تزريع أشاير حديد (10 – 22 مم)', unit: 'بالثقب الواحد', range: 'يُفصل المصنعية عن مادة الإيبوكسي', notes: 'حسب القطر، عمق الزرع، ومادة Hilti / Sika / CMB' },
];

const factors = [
  ['قطر الفتحة وسُمك الخرسانة', 'كلما زاد قطر التاج الماسي أو سُمك الجدار أو السقف (20، 30، 40 سم) زاد وقت الحفر واستهلاك الألماس.'],
  ['كثافة حديد التسليح والخامة', 'تخريم الطوب يختلف عن الخرسانة المسلحة عالية الإجهاد أو الواجهات المكسوة بالسيراميك والرخام.'],
  ['عدد الفتحات أو أمتار القص', 'تُمنح خصومات واضحة ومجزية عند تنفيذ عدة فتحات في زيارة واحدة أو في مشروعات المقاولات والكميات.'],
  ['الارتفاع وسهولة الوصول', 'العمل على ارتفاعات تستدعي سقالات أو في مناور ضيقة أو أسقف مزدحمة بالخدمات يُراجع ضمن التقدير.'],
  ['الموقع والانتقال', 'الطلبات داخل القاهرة الكبرى تختلف عن الانتقال للمحافظات البعيدة التي يُفضل فيها تجميع الكميات.'],
  ['الترحيل والتجهيزات الإضافية', 'في أعمال القص بالمنشار، يُفصل سعر القص عن تقطيع البلوكات والرفع والترحيل ليكون العرض واضحًا 100%.'],
];

const faqs: [string, string][] = [
  ['هل الأسعار الموضحة في الجدول نهائية؟', 'الأسعار الموضحة هي نطاقات استرشادية واقعية للسوق المصري لتوضيح الميزانية المتوقعة؛ ويُؤكد السعر النهائي فورًا بعد مراجعة القطر والسُمك والعدد والموقع.'],
  ['هل يوجد حد أدنى لتكلفة الزيارة لفتحة واحدة فقط؟', 'نعم، في حالة طلب فتحة واحدة صغيرة فقط، يُراعى في السعر تكلفة الانتقال وتجهيز الماكينة؛ لذلك يُنصح بتجميع كل فتحات التكييف والغاز والسباكة في زيارة واحدة.'],
  ['كيف أحسب تكلفة قص باب أو شباك بالمنشار الماسي؟', 'اجمع أطوال خطوط القص الفعلية بالمتر الطولي (مثلاً باب 2.2م × 1م بدون قطع أرضي = 5.4 متر طولي) ثم اضربها في سعر المتر حسب سُمك الحائط.'],
  ['هل توجد خصومات لشركات المقاولات ومهندسي التشطيبات؟', 'نعم، نقدم أسعارًا تعاقدية مخصصة للمشروعات السكنية والتجارية والمصانع التي تشمل جداول فتحات متعددة أو أمتار قص كبيرة.'],
];
---

<Layout
  title="أسعار فتحات الكور وسعر قص وتخريم الخرسانة في مصر | 01271940742"
  description="دليل أسعار فتحات الكور بالبوصة وسعر متر قص الخرسانة بالمنشار الماسي وتزريع الأشاير في مصر مع عوامل التسعير والخصومات للكميات. اتصل 01271940742."
  faqs={faqs}
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <span>أسعار الخدمات</span>
      </nav>
      <h1>أسعار فتحات الكور وسعر قص وتخريم الخرسانة — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">
        نطاقات سعرية استرشادية واضحة لفتحات الكور دريل بالبوصة وقص الخرسانة بالمتر الطولي في مصر، مع بيان العوامل التي تحدد السعر النهائي قبل بدء التنفيذ.
      </p>
      <div class="actions-row">
        <a href="tel:+201271940742" class="btn btn-primary">تأكيد السعر هاتفيًا <bdi dir="ltr">01271940742</bdi></a>
        <a href="#quote" class="btn btn-outline">اطلب عرض سعر لموقعك</a>
      </div>
    </div>
  </header>

  <section class="section-surface">
    <div class="container">
      <div class="section-header">
        <span class="section-label">جدول أسعار فتحات الكور</span>
        <h2>الأسعار الاسترشادية لتخريم الخرسانة بالكور دريل حسب القطر</h2>
        <p>تُحتسب أسعار فتحات الكور حسب قطر الفتحة بالبوصة ونوع العنصر (حائط أم سقف خرساني مسلح).</p>
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th scope="col">قطر الفتحة</th>
              <th scope="col">أشهر الاستخدامات</th>
              <th scope="col">حائط (سُمك قياسي)</th>
              <th scope="col">سقف مسلح / فلات سلاب</th>
            </tr>
          </thead>
          <tbody>
            {corePrices.map(row => (
              <tr>
                <td><strong>{row.diameter}</strong></td>
                <td>{row.use}</td>
                <td><strong>{row.wall}</strong></td>
                <td><strong>{row.slab}</strong></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-caption">تنويه: الأسعار استرشادية وتُؤكد نهائيًا حسب سُمك الخرسانة، كثافة التسليح، العدد الإجمالي، والموقع. راجع <a class="text-link" href="/خدماتنا/تخريم-خرسانة/">تفاصيل خدمة تخريم الخرسانة بالكور</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">جدول قص الخرسانة وتزريع الأشاير</span>
        <h2>أسعار قص الخرسانة بالمنشار الماسي وتزريع أشاير الحديد</h2>
      </div>
      <div class="table-wrap">
        <table class="spec-table">
          <thead>
            <tr>
              <th scope="col">البند الهندسي</th>
              <th scope="col">وحدة القياس</th>
              <th scope="col">النطاق الاسترشادي</th>
              <th scope="col">ملاحظات التنفيذ</th>
            </tr>
          </thead>
          <tbody>
            {cuttingPrices.map(row => (
              <tr>
                <td><strong>{row.service}</strong></td>
                <td>{row.unit}</td>
                <td><strong>{row.range}</strong></td>
                <td>{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="actions-row">
        <a href="/خدماتنا/قص-الخرسانة-بالمنشار/" class="text-link">تفاصيل قص الخرسانة بالمنشار الماسي ←</a>
        <a href="/خدماتنا/تزريع-اشاير-حديد/" class="text-link">تفاصيل تزريع أشاير الحديد والإيبوكسي ←</a>
        <a href="/مقالات/concrete-cutting-prices/" class="text-link">كيف تقارن عروض أسعار قص الخرسانة؟ ←</a>
      </div>
    </div>
  </section>

  <section class="section-surface">
    <div class="container">
      <div class="section-header">
        <span class="section-label">معايير التسعير الشفاف</span>
        <h2>6 عوامل تحدد السعر النهائي لأعمال الكور والقص</h2>
      </div>
      <div class="grid-3">
        {factors.map(([name, text]) => (
          <div class="card">
            <h3>{name}</h3>
            <p class="spaced-copy">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">أسئلة التسعير</span>
        <h2>استفسارات شائعة حول أسعار فتحات الكور والقص</h2>
        <p class="spaced-copy">وضوح وحدة القياس وبنود العرض يضمن عدم وجود أي مصاريف مفاجئة في الموقع.</p>
      </div>
      <div class="native-faq">
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt" id="quote">
    <div class="container split-asymmetric">
      <div>
        <span class="section-label">عرض سعر دقيق</span>
        <h2>احصل على تسعير نهائي لموقعك اليوم</h2>
        <p class="spaced-copy">
          اكتب عدد الفتحات والأقطار أو أبعاد القص والمنطقة، أو اتصل مباشرة على <a class="text-link" href="tel:+201271940742"><bdi dir="ltr">01271940742</bdi></a> لتأكيد التكلفة وأقرب موعد تنفيذ.
        </p>
      </div>
      <QuoteRequest />
    </div>
  </section>
</Layout>
