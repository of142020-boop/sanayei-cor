import Layout from '../../layouts/Layout.astro';
const faqs = [
 ['ما هو الكور دريل؟', 'معدة تستخدم رأسًا أسطوانيًا ماسيًا لتجهيز فتحة دائرية في الخرسانة أو خامات أخرى، لتمرير مواسير أو كابلات حسب متطلبات الموقع.'],
 ['ما الفرق بين الكور والمنشار الماسي؟', 'الكور يعمل فتحات دائرية، بينما يستخدم المنشار للقص المستقيم مثل فتحات الأبواب والنوافذ. تتحدد الطريقة المناسبة بناءً على شكل الفتحة والخامة.'],
 ['كم سعر فتحة الكور؟', 'تتحدد التكلفة حسب القطر والعمق والخامة وعدد الفتحات والمنطقة وسهولة الوصول. أرسل تفاصيل الموقع والصور للحصول على تقدير، ثم اتفق على السعر ونطاق العمل قبل التنفيذ.'],
 ['هل يمكن تخريم عمود أو كمرة أو سقف؟', 'العمل في العناصر الإنشائية يحتاج مراجعة واعتماد مهندس إنشائي قبل التنفيذ. الكور لا يضمن بمفرده سلامة العنصر، ولا يجوز افتراض السماح بقطع حديد التسليح.'],
 ['كيف أحدد قطر فتحة الغاز أو التكييف؟', 'اطلب المقاس والمكان والميل من شركة الغاز أو فني التركيب. القطر يعتمد على الماسورة والجهاز والخلوص المطلوب؛ لا يوجد قطر موحد لكل الحالات.'],
 ['هل توجد مياه أو مخلفات أثناء الحفر؟', 'الحفر الرطب يستخدم المياه للتبريد وينتج مياه ومخلفات حفر تحتاج للتجميع. اتفق قبل الزيارة على حماية التشطيبات وتجميع المخلفات وتجهيز الكهرباء والمياه.'],
 ['كم يستغرق التنفيذ؟', 'المدة تتوقف على عدد الفتحات وعمقها وخامتها وإمكانية تثبيت المعدة والوصول. يُراجع الوقت المتوقع بعد الاطلاع على تفاصيل الموقع.'],
 ['ما مناطق الخدمة؟', 'توجد صفحات لخدمات القاهرة والجيزة والتجمع الخامس وأكتوبر وزايد والإسكندرية. تواصل لتأكيد إمكانية الوصول إلى عنوانك والموعد المتاح قبل الحجز.'],
 ['ماذا أرسل لطلب عرض سعر؟', 'أرسل المنطقة وصور المكان وعدد الفتحات ومقاساتها وسُمك الحائط إن أمكن. وضّح الارتفاع والخامة والغرض من الفتحة وأي متطلبات خاصة بالدخول أو العمل.'],
];
