---
import Layout from '../../layouts/Layout.astro';

const faqs: [string, string][] = [
  ['ما هو الكور دريل وما الفرق بينه وبين التكسير بالشاكوش؟', 'الكور دريل ماكينة حفر أسطوانية بتاج ماسي مبرد بالماء تخرج فتحة دائرية صافية الحواف بدون طرق أو اهتزازات، بينما الشاكوش يعتمد على التكسير مما يسبب شروخًا وتلفًا في السيراميك والدهانات المحيطة.'],
  ['ما الفرق بين تخريم الخرسانة بالكور وقص الخرسانة بالمنشار الماسي؟', 'الكور دريل مخصص للفتحات الدائرية (تكييف، غاز، سباكة، شفاطات، كابلات بأقطار 1–12 بوصة)، بينما المنشار الماسي الجداري ومنشار السلك مخصصان لخطوط القطع المستقيمة كفتحات الأبواب والنوافذ والسلالم.'],
  ['كم سعر فتحة الكور وسعر متر قص الخرسانة في مصر؟', 'يتراوح السعر الاسترشادي لفتحة الكور بين 200 و350 ج.م لأقطار 1–2 بوصة، و250–400 ج.م لأقطار 3–4 بوصة، و350–550 ج.م لأقطار 5–6 بوصة، بينما يتراوح قص الخرسانة بالمنشار بين 500 و1,300 ج.م للمتر الطولي حسب سُمك الخرسانة والتسليح.'],
  ['هل يمكن تخريم سقف خرساني أو كمرة أو عمود بالكور؟', 'أي فتحة أو قص داخل عنصر إنشائي حامل (سقف فلات سلاب، كمرة، أو عمود) تستلزم مراجعة واعتماد مهندس إنشائي لموضع الفتحة قبل التنفيذ لضمان عدم الإضرار بحديد التسليح الرئيسي.'],
  ['ما القطر المطلوب لفتحة التكييف وفتحة الغاز ومدخنة الشفاط؟', 'غالبًا تكون فتحة تكييف السبليت 2–2.5 بوصة، ماسورة الغاز 1.5–2 بوصة، هواية الغاز ومدخنة السخان 4–5 بوصة، ودكت شفاط المطبخ 5–6 بوصة، مع مراجعة توصية فني التركيب أو معاينة شركة الغاز قبل الحفر.'],
  ['هل يتلف السيراميك أو الرخام أثناء عمل فتحة الكور؟', 'لا؛ نلغي وضع الدقاق ونثبت الماكينة بقاعدة محكمة مع تبريد مائي مستمر لتخرج الفتحة دائرية نظيفة في السيراميك والبورسلين والرخام دون كسور أو شروخ.'],
  ['هل تنتج مياه أو أتربة أثناء الحفر الرطب بالكور؟', 'التبريد المائي يمنع تطاير الغبار تمامًا، ونعمل على تجميع مياه التبريد وقلب الخرسانة مع حماية الأثاث والدهانات المجاورة؛ ويُفضّل إبعاد الأثاث القريب وتوفير مصدر كهرباء ومياه.'],
  ['ما حقيقة مصطلح قص الخرسانة بالليزر؟', 'لا يوجد قص خرسانة تجاري بشعاع ليزر؛ المصطلح يشير في السوق المصري إلى القص الدقيق بالمنشار الماسي المبرد بالماء، وقد يُستخدم ميزان الليزر فقط لضبط استقامة خط القص.'],
  ['ما أفضل مواد تزريع أشاير الحديد المستخدمة في مصر؟', 'تُستخدم أنظمة الإيبوكسي الكيميائي المعتمدة هندسيًا مثل Hilti HIT-RE 500 وSikadur-31 وKemaboxy 165 (CMB) بعد تنظيف الثقوب بالهواء والفرشاة وفق توصية الاستشاري.'],
  ['كيف أجهز طلبي للحصول على تسعير دقيق وسريع؟', 'حدد نوع العمل (تخريم كور أم قص بالمنشار أم تركيب شفاط أم تزريع أشاير)، الأقطار أو الأبعاد، العدد، سُمك الخرسانة إن عُرف، والمنطقة، واتصل على 01271940742 لتأكيد السعر والموعد.'],
];
---

<Layout
  title="الأسئلة الشائعة حول فتحات الكور وقص الخرسانة | 01271940742"
  description="إجابات هندسية واضحة حول أسعار فتحات الكور، قص الخرسانة بالمنشار، تخريم الأسقف والسيراميك، مقاسات التكييف والغاز والشفاطات، وتزريع الأشاير. 01271940742."
  faqs={faqs}
>
  <header class="page-banner">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span>›</span>
        <span>الأسئلة الشائعة</span>
      </nav>
      <h1>الأسئلة الشائعة حول فتحات الكور وقص الخرسانة — <bdi dir="ltr">01271940742</bdi></h1>
      <p class="banner-lead">
        إجابات فنية مباشرة تساعدك على تحديد المقاس والمعدة المناسبة وفهم عوامل التسعير والسلامة الإنشائية قبل بدء التنفيذ.
      </p>
    </div>
  </header>

  <section class="section-surface">
    <div class="container-narrow">
      <div class="native-faq">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
      <div class="actions-row mt-32">
        <a href="tel:+201271940742" class="btn btn-primary">اتصل للاستفسار <bdi dir="ltr">01271940742</bdi></a>
        <a href="/اسعار-الخدمات/" class="btn btn-outline">جدول الأسعار الاسترشادية</a>
        <a href="/خدماتنا/تخريم-خرسانة/" class="btn btn-outline">تفاصيل تخريم الخرسانة</a>
      </div>
    </div>
  </section>
</Layout>
